.page { background: #F7F7F7; min-height: 100vh; padding-bottom: 40rpx; }
.header { background: #fff; padding: 32rpx; display: flex; align-items: baseline; gap: 16rpx; }
.header-title { font-size: 36rpx; font-weight: 700; color: #333; }
.header-sub { font-size: 24rpx; color: #888; }

.empty { text-align: center; padding: 120rpx 32rpx; }
.empty-icon { display: block; font-size: 80rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 30rpx; color: #333; font-weight: 600; display: block; margin-bottom: 12rpx; }
.empty-desc { font-size: 26rpx; color: #888; display: block; line-height: 1.6; }

.sub-list { padding: 16rpx 32rpx; }
.sub-card { background: #fff; border-radius: 8rpx; padding: 24rpx; margin-top: 16rpx; }
.sub-card-hover { background: #F7F7F7; }
.sub-info { display: flex; align-items: baseline; gap: 12rpx; margin-bottom: 16rpx; }
.sub-name { font-size: 30rpx; font-weight: 600; color: #333; }
.sub-zone { font-size: 22rpx; color: #07C160; background: rgba(7,193,96,0.08); padding: 4rpx 12rpx; border-radius: 4rpx; }
.sub-stats { display: flex; gap: 24rpx; margin-bottom: 16rpx; }
.sub-count { font-size: 26rpx; color: #07C160; font-weight: 600; }
.sub-price { font-size: 26rpx; color: #333; }
.sub-actions { display: flex; justify-content: space-between; align-items: center; border-top: 1rpx solid #F0F0F0; padding-top: 16rpx; }
.sub-goto { font-size: 26rpx; color: #07C160; }
.sub-unsub { font-size: 24rpx; color: #888; padding: 8rpx 16rpx; }

.state-msg { text-align: center; padding: 120rpx; color: #888; font-size: 28rpx; }
.err-block { background: #FFF7E6; border-radius: 8rpx; padding: 32rpx; text-align: center; color: #FAAD14; font-size: 28rpx; margin: 32rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.err-icon { width: 40rpx; height: 40rpx; line-height: 40rpx; border-radius: 50%; background: #FAAD14; color: #fff; font-size: 24rpx; font-weight: 700; text-align: center; }

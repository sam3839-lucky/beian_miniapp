<view class="page">
  <!-- 会员卡片 -->
  <view class="member-card {{tier === 'free' ? 'free' : 'pro'}}">
    <view class="mc-badge" wx:if="{{tier === 'pro' || tier === 'team'}}">
      <text>PRO</text>
    </view>
    <text class="mc-tier">{{tierLabel}}</text>
    <text class="mc-expire" wx:if="{{tier === 'free'}}">升级解锁全部功能</text>
    <text class="mc-expire" wx:else>有效期至 {{expireText || '--'}}</text>
    <view class="mc-upgrade" wx:if="{{tier === 'free'}}" bindtap="onUpgrade" hover-class="mc-upgrade-hover">
      <text>升级专业版 ¥29/月</text>
    </view>
  </view>

  <!-- 今日用量（仅免费用户） -->
  <view class="usage-section" wx:if="{{tier === 'free'}}">
    <text class="us-title">今日用量</text>
    <view class="us-row">
      <text class="usr-name">瞬搜查价</text>
      <text class="usr-val">{{searchesUsed}}/{{searchesMax}} 次</text>
    </view>
    <view class="us-row">
      <text class="usr-name">分享海报</text>
      <text class="usr-val">{{postersUsed}}/{{postersMax}} 张</text>
    </view>
    <view class="us-row">
      <text class="usr-name">关注项目</text>
      <text class="usr-val">{{followsCount}}/{{followsMax}} 个</text>
    </view>
  </view>

  <!-- 权益对比 -->
  <view class="benefits-section">
    <text class="bs-title">专业版权益</text>
    <view wx:for="{{benefits}}" wx:key="name" class="benefit-row">
      <text class="br-name">{{item.name}}</text>
      <text class="br-check {{tier === 'team' || (tier === 'pro' && (item.pro || item.free)) || (tier === 'free' && item.free) ? 'have' : 'lack'}}">
        {{tier === 'team' || (tier === 'pro' && (item.pro || item.free)) || (tier === 'free' && item.free) ? '✓' : '—'}}
      </text>
    </view>
  </view>

  <view wx:if="{{tier === 'free'}}" class="bottom-cta" bindtap="onUpgrade" hover-class="bottom-cta-hover">
    <text>升级专业版 ¥29/月</text>
  </view>
</view>

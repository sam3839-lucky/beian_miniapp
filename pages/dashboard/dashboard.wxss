.page{background:linear-gradient(180deg,#F0F5FA 0%,#fff 30%);min-height:100vh;padding-bottom:40rpx}

/* 头部 */
.header{text-align:center;padding:48rpx 32rpx 24rpx}
.title{font-size:44rpx;font-weight:800;color:#0066B3;display:block}
.subtitle{font-size:24rpx;color:#8C9BA8;margin-top:8rpx;display:block}
.divider{width:80rpx;height:6rpx;background:linear-gradient(90deg,#0066B3,#34A853);margin:16rpx auto 0;border-radius:3rpx}

/* 6数据卡 */
.cards-grid{display:flex;flex-wrap:wrap;gap:12rpx;padding:0 24rpx;margin-bottom:32rpx}
.card{width:calc((100% - 24rpx) / 3);background:#fff;border-radius:12rpx;padding:16rpx 6rpx 14rpx;border:1px solid #E8EDF2;box-shadow:0 2rpx 8rpx rgba(0,102,179,.04);text-align:center;box-sizing:border-box}
.card-label{font-size:20rpx;color:#5A6B7A;display:block;margin-bottom:6rpx}
.card-value{font-size:36rpx;font-weight:800;display:block;margin-bottom:6rpx}
.card-new .card-value{color:#0066B3}
.card-used .card-value{color:#34A853}
.card-unit{font-size:24rpx;font-weight:400}
.card-sub{font-size:20rpx;color:#8C9BA8}

/* 走势图 */
.chart-section{background:#fff;margin:0 24rpx 32rpx;border-radius:16rpx;padding:24rpx 20rpx 20rpx;border:1px solid #E8EDF2;box-shadow:0 2rpx 12rpx rgba(0,0,0,.03)}
.section-title{font-size:28rpx;font-weight:700;color:#1A2B3C;display:block;margin-bottom:16rpx}
.chart-legend{display:flex;justify-content:center;align-items:center;gap:8rpx;font-size:20rpx;color:#8C9BA8;margin-bottom:12rpx}
.leg-dot{width:16rpx;height:16rpx;border-radius:4rpx}
.leg-new{background:#7EB8E0}.leg-used{background:#0066B3}
.leg-line{width:24rpx;height:0;border-top:2rpx dashed}.leg-lnew{border-color:#7EB8E0}.leg-lused{border-color:#0066B3}
.trend-canvas{width:100%;height:240rpx}

/* 重点看板 */
.panel-section{margin:0 24rpx 32rpx}
.panel-row{display:flex;gap:16rpx;margin-top:16rpx}
.panel-card{flex:1;background:#F5F7FA;border-radius:14rpx;padding:20rpx;border:1px solid #EBEFF4;text-align:center}
.plabel{font-size:20rpx;color:#8C9BA8;display:block;margin-bottom:8rpx}
.pvalue{font-size:36rpx;font-weight:700;color:#1A2B3C}
.punit{font-size:22rpx;font-weight:400;color:#A0ACB8}
.prow{font-size:22rpx;color:#1A2B3C;line-height:2}

/* 领取按钮 */
.poster-bar{padding:32rpx 32rpx}
.poster-btn{background:linear-gradient(135deg,#0066B3,#005299);border-radius:16rpx;padding:36rpx;text-align:center;color:#fff;font-size:32rpx;font-weight:600;min-height:88rpx;display:flex;flex-direction:column;justify-content:center;gap:8rpx}
.poster-hint{font-size:22rpx;font-weight:400;opacity:.8}

/* 加载/错误 */
.loading{padding:160rpx 32rpx;text-align:center;color:#8C9BA8;font-size:28rpx}
.err-block{padding:160rpx 32rpx;text-align:center;color:#8C9BA8;font-size:28rpx}

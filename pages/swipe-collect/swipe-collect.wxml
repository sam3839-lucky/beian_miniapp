<view class="page">
  <view class="header">
    <text class="title">📥 爆款文案入库</text>
    <text class="subtitle">粘贴文案，一键存入参考库</text>
  </view>

  <view class="form">
    <view class="field">
      <text class="label">标题（可选）</text>
      <input class="input" placeholder="自动取前30字" value="{{title}}" bindinput="onTitleInput" />
    </view>

    <view class="field">
      <text class="label">文案内容 *</text>
      <textarea class="textarea" placeholder="粘贴文案全文…" value="{{copyContent}}" bindinput="onContentInput" maxlength="-1" auto-height />
    </view>

    <view class="field-row">
      <view class="field half">
        <text class="label">平台</text>
        <picker mode="selector" range="{{platforms}}" value="{{platformIndex}}" bindchange="onPlatformChange">
          <view class="picker">{{platforms[platformIndex]}}</view>
        </picker>
      </view>
      <view class="field half">
        <text class="label">地域</text>
        <input class="input" placeholder="如：上海" value="{{region}}" bindinput="onRegionInput" />
      </view>
    </view>

    <button class="submit-btn" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">
      {{submitting ? '提交中…' : '入库'}}
    </button>
  </view>

  <view wx:if="{{recentList.length}}" class="recent">
    <text class="recent-title">最近入库（{{recentList.length}}条）</text>
    <view wx:for="{{recentList}}" wx:key="id" class="recent-item">
      <text class="recent-text">{{item.title}}</text>
      <text class="recent-time">{{item.time}}</text>
    </view>
  </view>
</view>

/* ═══ 成交分析 — WeUI 规范 ═══ */
.page { background: #F7F7F7; min-height: 100vh; padding-bottom: 40rpx; }

/* ═══ 搜小区入口 ═══ */
.history-search-bar { margin: 16rpx 32rpx; background: #fff; border-radius: 8rpx; padding: 0 24rpx; height: 84rpx; display: flex; align-items: center; }
.hs-icon { font-size: 28rpx; margin-right: 12rpx; flex-shrink: 0; }
.hs-text { flex: 1; font-size: 26rpx; color: #bbb; }
.hs-badge { font-size: 20rpx; color: #fff; background: #07C160; padding: 4rpx 14rpx; border-radius: 20rpx; flex-shrink: 0; font-weight: 600; }

/* ═══ 环形图 ═══ */
.ring-card { background: #fff; margin: 12rpx 32rpx; border-radius: 8rpx; padding: 28rpx 0 24rpx; text-align: center; }
.ring-title { font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 4rpx; }
.ring-date { font-size: 22rpx; color: #888; margin-bottom: 16rpx; }
.ring-wrap { width: 400rpx; height: 400rpx; margin: 0 auto; }
.donut-canvas { width: 400rpx; height: 400rpx; }
.ring-legend { display: flex; justify-content: center; gap: 40rpx; margin-top: 20rpx; }
.legend-item { display: flex; align-items: center; gap: 8rpx; font-size: 26rpx; color: #333; }
.ldot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.ldot.new { background: #07C160; }
.ldot.used { background: #FF8C00; }
.lnum { font-weight: 700; }
.lpct { color: #888; font-size: 24rpx; }

/* ═══ Section ═══ */
.section { margin: 32rpx 32rpx 0; }
.section-head { margin-bottom: 20rpx; }
.section-title { font-size: 32rpx; font-weight: 700; color: #333; }

/* ═══ 成交概况表格 ═══ */
.data-table { background: #fff; border-radius: 8rpx; overflow: hidden; }
.th-row { display: flex; align-items: center; padding: 20rpx 28rpx 14rpx; border-bottom: 1rpx solid #E5E5E5; }
.th-label { width: 100rpx; flex-shrink: 0; }
.th-val { flex: 1; text-align: center; font-size: 24rpx; color: #A8A8A8; }
.td-row { display: flex; align-items: center; padding: 20rpx 28rpx; border-bottom: 0.5px solid #F0F0F0; }
.td-row.total { background: #FAFAFA; font-weight: 700; }
.td-label { width: 100rpx; flex-shrink: 0; font-size: 28rpx; color: #333; font-weight: 500; display: flex; align-items: center; gap: 8rpx; }
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; display: inline-block; flex-shrink: 0; }
.dot.new { background: #07C160; }
.dot.used { background: #FF8C00; }
.td-val { flex: 1; text-align: center; font-size: 28rpx; color: #333; font-weight: 600; }
.td-val.up { color: #07C160; }
.td-val.down { color: #FF4D4F; }

/* ═══ 各区占比 ═══ */
.two-col { display: flex; gap: 16rpx; }
.dcol { flex: 1; background: #fff; border-radius: 8rpx; padding: 20rpx; }
.dcol-title { font-size: 26rpx; font-weight: 600; color: #333; margin-bottom: 16rpx; display: flex; align-items: center; gap: 8rpx; }
.dcdot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.dcdot.new { background: #07C160; }
.dcdot.used { background: #FF8C00; }
.drow { display: flex; align-items: center; gap: 8rpx; padding: 8rpx 0; }
.drow + .drow { border-top: 0.5px solid #F0F0F0; }
.dname { font-size: 24rpx; color: #333; font-weight: 500; width: 60rpx; }
.dbar-wrap { flex: 1; height: 14rpx; border-radius: 4rpx; background: #F0F0F0; overflow: hidden; }
.dbar { height: 100%; border-radius: 4rpx; }
.dbar.new { background: #07C160; }
.dbar.used { background: #FF8C00; }
.dcnt { font-size: 22rpx; color: #888; width: 56rpx; text-align: right; }
.dpct { font-size: 22rpx; color: #333; font-weight: 600; width: 64rpx; text-align: right; }

/* ═══ 销量排行 ═══ */
.sales-tabs { white-space: nowrap; margin-bottom: 16rpx; }
.sales-tab { display: inline-block; font-size: 24rpx; color: #888; background: #fff; padding: 12rpx 24rpx; border-radius: 8rpx; margin-right: 12rpx; }
.sales-tab.on { background: #07C160; color: #fff; font-weight: 600; }
.sales-list { background: #fff; border-radius: 8rpx; overflow: hidden; }
.sales-row { display: flex; align-items: center; padding: 18rpx 24rpx; gap: 16rpx; border-bottom: 1rpx solid #F0F0F0; }
.sales-row:last-child { border-bottom: none; }
.sales-row-hover { background: #F7F7F7; }
.sr-idx { font-size: 28rpx; font-weight: 700; color: #07C160; width: 40rpx; text-align: center; }
.sr-info { flex: 1; min-width: 0; }
.sr-name { font-size: 28rpx; font-weight: 500; color: #333; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sr-zone { font-size: 22rpx; color: #07C160; background: rgba(7,193,96,0.08); padding: 2rpx 10rpx; border-radius: 4rpx; display: inline-block; margin-top: 4rpx; }
.sr-count { font-size: 30rpx; font-weight: 700; color: #333; flex-shrink: 0; }
.sales-empty { text-align: center; padding: 48rpx 32rpx; font-size: 26rpx; color: #888; }
.sales-note { text-align: center; font-size: 20rpx; color: #A8A8A8; padding: 12rpx 0; }

/* ═══ 时间范围 ═══ */
.range-bar { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.range-tab { flex: 1; text-align: center; padding: 16rpx 0; font-size: 26rpx; color: #888;
  background: #fff; border-radius: 8rpx; min-height: 64rpx; display: flex;
  align-items: center; justify-content: center; }
.range-tab.on { background: #07C160; color: #fff; font-weight: 600; }

/* ═══ 月度走势图 ═══ */
.chart-card { background: #fff; border-radius: 8rpx; padding: 16rpx 12rpx 8rpx; }
.trend-chart-wrap { width: 100%; height: 400rpx; }
.trend-canvas { width: 100%; height: 400rpx; }
.chart-legend { display: flex; justify-content: center; gap: 24rpx; padding: 8rpx 0 4rpx; font-size: 22rpx; color: #888; align-items: center; }
.chart-legend .dot { width: 14rpx; height: 14rpx; border-radius: 50%; display: inline-block; margin-right: 6rpx; }
.chart-legend .dot.new { background: #07C160; }
.chart-legend .dot.used { background: #FF8C00; }

/* ═══ 日成交 ═══ */
.tx-list { background: #fff; border-radius: 8rpx; }
.tx-item { display: flex; align-items: center; padding: 20rpx 28rpx; gap: 16rpx;
  min-height: 76rpx; border-top: 1rpx solid #F0F0F0; }
.tx-item:first-child { border-top: none; }
.tx-date { font-size: 26rpx; font-weight: 500; color: #333; width: 170rpx; flex-shrink: 0; }
.tx-new { font-size: 24rpx; color: #07C160; text-align: right; width: 120rpx; white-space: nowrap; }
.tx-used { font-size: 24rpx; color: #FF8C00; text-align: right; width: 120rpx; white-space: nowrap; }
.tx-total { font-size: 26rpx; font-weight: 700; color: #333; text-align: right; flex: 1; }

/* ═══ 备注 ═══ */
.note { text-align: center; font-size: 22rpx; color: #A8A8A8; padding: 24rpx 0; }

/* ═══ 错误/加载 ═══ */
.err-block { background: #FFF7E6; border-radius: 8rpx; padding: 32rpx; text-align: center;
  color: #FAAD14; font-size: 28rpx; margin: 32rpx; display: flex; align-items: center;
  justify-content: center; gap: 12rpx; min-height: 88rpx; }
.err-icon { width: 40rpx; height: 40rpx; line-height: 40rpx; border-radius: 50%;
  background: #FAAD14; color: #fff; font-size: 24rpx; font-weight: 700; text-align: center; }
.state-msg { text-align: center; padding: 80rpx 32rpx; color: #888; font-size: 28rpx; }

/* ═══ 成交分析 — WeUI 规范 ═══ */

.page { background: #F7F7F7; min-height: 100vh; padding-bottom: 40rpx; }

/* 时间范围切换 */
.range-bar { display: flex; background: #fff; padding: 16rpx 32rpx; gap: 16rpx; }
.range-tab { flex: 1; text-align: center; padding: 16rpx 0; font-size: 26rpx; color: #888;
  background: #F7F7F7; border-radius: 8rpx; min-height: 64rpx; display: flex;
  align-items: center; justify-content: center; }
.range-tab.on { background: #07C160; color: #fff; font-weight: 600; }

/* 概览 Hero */
.overview-hero { background: #fff; margin: 24rpx 32rpx; border-radius: 16rpx;
  padding: 40rpx 32rpx 32rpx; text-align: center; }
.hero-num { font-size: 80rpx; font-weight: 800; color: #07C160; line-height: 1; }
.hero-label { font-size: 26rpx; color: #888; margin: 12rpx 0 24rpx; display: block; }
.hero-detail { display: flex; flex-wrap: wrap; justify-content: center; gap: 12rpx; }
.hero-row { display: flex; justify-content: center; gap: 16rpx; }
.hero-tag { font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 20rpx; font-weight: 500; }
.hero-tag.new { background: #E8F8EF; color: #07C160; }
.hero-tag.used { background: #FFF3E6; color: #FF8C00; }
.hero-tag.up { background: #E8F8EF; color: #07C160; }
.hero-tag.down { background: #FFEEEE; color: #FF4D4F; }

/* Section */
.section { margin: 32rpx 32rpx 0; }
.section-head { margin-bottom: 20rpx; }
.section-title { font-size: 32rpx; font-weight: 700; color: #333; }

/* 月度走势（新房+二手堆叠条） */
.trend-chart { background: #fff; border-radius: 8rpx; padding: 16rpx 16rpx 4rpx; }
.trend-row { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 0; min-height: 60rpx; }
.trend-row + .trend-row { border-top: 1rpx solid #F0F0F0; }
.tr-month { font-size: 22rpx; color: #888; width: 70rpx; text-align: center; }
.tr-bar-wrap { flex: 1; height: 20rpx; border-radius: 10rpx; background: #F0F0F0; overflow: hidden; display: flex; }
.tr-bar-new { height: 100%; background: #07C160; }
.tr-bar-used { height: 100%; background: #FF8C00; }
.tr-count { font-size: 24rpx; color: #333; font-weight: 600; width: 120rpx; text-align: right; white-space: nowrap; }
.trend-legend { display: flex; gap: 20rpx; padding: 12rpx 16rpx 8rpx; font-size: 22rpx; color: #888; align-items: center; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; display: inline-block; margin-right: 4rpx; }
.dot.new { background: #07C160; }
.dot.used { background: #FF8C00; }

/* 日成交列表 */
.tx-list { background: #fff; border-radius: 8rpx; }
.tx-item { display: flex; align-items: center; padding: 20rpx 28rpx; gap: 20rpx;
  min-height: 76rpx; border-top: 1rpx solid #F0F0F0; }
.tx-item:first-child { border-top: none; }
.tx-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.tx-date { font-size: 26rpx; font-weight: 500; color: #333; }
.tx-area { font-size: 22rpx; color: #A8A8A8; }
.tx-price { text-align: right; display: flex; flex-direction: column; gap: 4rpx; flex-shrink: 0; }
.tx-total { font-size: 30rpx; font-weight: 700; color: #333; }
.tx-unit { font-size: 22rpx; color: #888; }

.data-note { text-align: center; font-size: 22rpx; color: #A8A8A8; padding: 24rpx 0; }

/* 错误态 */
.err-block { background: #FFF7E6; border-radius: 8rpx; padding: 32rpx; text-align: center;
  color: #FAAD14; font-size: 28rpx; margin: 32rpx; display: flex; align-items: center;
  justify-content: center; gap: 12rpx; min-height: 88rpx; }
.err-icon { width: 40rpx; height: 40rpx; line-height: 40rpx; border-radius: 50%;
  background: #FAAD14; color: #fff; font-size: 24rpx; font-weight: 700; text-align: center; }
.state-msg { text-align: center; padding: 80rpx 32rpx; color: #888; font-size: 28rpx; }

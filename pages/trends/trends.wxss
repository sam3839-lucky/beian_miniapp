/* ═══ 成交分析 — WeUI 规范 ═══ */

.page { background: #F7F7F7; min-height: 100vh; padding-bottom: 40rpx; }

/* 时间范围切换 */
.range-bar {
  display: flex;
  background: #fff;
  padding: 16rpx 32rpx;
  gap: 16rpx;
}
.range-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #888;
  background: #F7F7F7;
  border-radius: 8rpx;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.range-tab.on {
  background: #07C160;
  color: #fff;
  font-weight: 600;
}

/* 概览卡片 */
.overview { display: flex; padding: 24rpx 32rpx; gap: 16rpx; }
.stat-card { flex: 1; background: #fff; border-radius: 8rpx; padding: 24rpx 8rpx;
  text-align: center; display: flex; flex-direction: column; gap: 8rpx; }
.stat-num { font-size: 40rpx; font-weight: 700; color: #333; }
.stat-num.green { color: #07C160; }
.stat-num.red { color: #FF4D4F; }
.stat-label { font-size: 22rpx; color: #888; }

/* Section */
.section { margin: 32rpx 32rpx 0; }
.section-head { margin-bottom: 20rpx; }
.section-title { font-size: 32rpx; font-weight: 700; color: #333; }

/* 月度走势 */
.trend-chart {
  background: #fff;
  border-radius: 8rpx;
  padding: 16rpx 16rpx 4rpx;
}
.trend-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  min-height: 60rpx;
}
.trend-row + .trend-row { border-top: 1rpx solid #F0F0F0; }
.tr-month { font-size: 22rpx; color: #888; width: 60rpx; text-align: center; }
.tr-bar-wrap { flex: 1; height: 20rpx; border-radius: 10rpx; background: #F0F0F0; overflow: hidden; }
.tr-bar { height: 100%; border-radius: 10rpx; background: linear-gradient(90deg, #07C160, #34D399); min-width: 4rpx; }
.tr-count { font-size: 24rpx; color: #333; font-weight: 600; width: 80rpx; text-align: right; }
.tr-price { font-size: 22rpx; color: #888; width: 90rpx; text-align: right; }

/* 区域排名 */
.zone-compare { background: #fff; border-radius: 8rpx; padding: 8rpx 28rpx; }
.zone-row { display: flex; align-items: center; gap: 20rpx; padding: 14rpx 0; min-height: 88rpx; }
.zone-row + .zone-row { border-top: 1rpx solid #E5E5E5; }
.zname { font-size: 26rpx; font-weight: 500; color: #333; width: 90rpx; }
.zcount { font-size: 24rpx; color: #07C160; font-weight: 600; width: 80rpx; text-align: right; }
.zbar-wrap { flex: 1; height: 12rpx; border-radius: 6rpx; background: #F0F0F0; overflow: hidden; }
.zbar { height: 100%; border-radius: 6rpx; background: #07C160; }
.zprice { font-size: 24rpx; color: #888; width: 80rpx; text-align: right; }

/* 近期成交列表 */
.tx-list { background: #fff; border-radius: 8rpx; }
.tx-item { display: flex; align-items: center; padding: 20rpx 28rpx; gap: 20rpx;
  min-height: 88rpx; border-top: 1rpx solid #F0F0F0; }
.tx-item:first-child { border-top: none; }
.tx-item-hover { background: #F7F7F7; }
.tx-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.tx-proj { font-size: 28rpx; font-weight: 500; color: #333;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tx-unit { font-size: 24rpx; color: #888; }
.tx-price { text-align: right; display: flex; flex-direction: column; gap: 4rpx; flex-shrink: 0; }
.tx-total { font-size: 30rpx; font-weight: 700; color: #FF4D4F; }
.tx-date { font-size: 22rpx; color: #888; }

/* 错误态 */
.err-block { background: #FFF7E6; border-radius: 8rpx; padding: 32rpx; text-align: center;
  color: #FAAD14; font-size: 28rpx; margin: 32rpx; display: flex; align-items: center;
  justify-content: center; gap: 12rpx; min-height: 88rpx; }
.err-icon { width: 40rpx; height: 40rpx; line-height: 40rpx; border-radius: 50%;
  background: #FAAD14; color: #fff; font-size: 24rpx; font-weight: 700; text-align: center; }

/* 状态消息 */
.state-msg { text-align: center; padding: 80rpx 32rpx; color: #888; font-size: 28rpx; }

<view class="page">
  <view wx:if="{{loading && !summary}}" class="state-msg">加载中...</view>
  <view wx:if="{{error}}" class="err-block" bindtap="onRetry">
    <text class="err-icon">!</text><text>加载失败，点击重试</text>
  </view>

  <view wx:if="{{summary}}">
    <!-- ═══ 环形图 + 图例 ═══ -->
    <view class="ring-card">
      <view class="ring-title" wx:if="{{summary.monthTitle}}">{{summary.monthTitle}}累计成交统计</view>
      <view class="ring-date" wx:if="{{summary.latestLabel}}">截止到 {{summary.latestLabel}}</view>
      <view class="ring-wrap">
        <canvas type="2d" id="donutCanvas" class="donut-canvas"></canvas>
      </view>
      <view class="ring-legend">
        <view class="legend-item">
          <text class="ldot new"></text>
          <text>一手</text>
          <text class="lnum">{{summary.this_month.new}}</text>
          <text class="lpct">{{summary.newPct}}%</text>
        </view>
        <view class="legend-item">
          <text class="ldot used"></text>
          <text>二手</text>
          <text class="lnum">{{summary.this_month.used}}</text>
          <text class="lpct">{{summary.usedPct}}%</text>
        </view>
      </view>
    </view>

    <!-- ═══ 各区成交占比 ═══ -->
    <view class="section" wx:if="{{districts}}">
      <view class="section-head"><text class="section-title">各区成交占比</text></view>
      <view class="two-col">
        <view class="dcol">
          <view class="dcol-title"><text class="dcdot new"></text>一手</view>
          <view wx:for="{{districts.new.items}}" wx:key="zone" wx:for-item="d" class="drow">
            <text class="dname">{{d.zone}}</text>
            <view class="dbar-wrap"><view class="dbar new" style="width:{{d.pct * 2}}%"></view></view>
            <text class="dcnt">{{d.count}}</text>
            <text class="dpct">{{d.pct}}%</text>
          </view>
        </view>
        <view class="dcol">
          <view class="dcol-title"><text class="dcdot used"></text>二手</view>
          <view wx:for="{{districts.used.items}}" wx:key="zone" wx:for-item="d" class="drow">
            <text class="dname">{{d.zone}}</text>
            <view class="dbar-wrap"><view class="dbar used" style="width:{{d.pct * 2}}%"></view></view>
            <text class="dcnt">{{d.count}}</text>
            <text class="dpct">{{d.pct}}%</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ═══ 近30天楼盘销量排行 ═══ -->
    <view class="section" wx:if="{{salesRanks.length || salesZones.length}}">
      <view class="section-head"><text class="section-title">近30天楼盘销量排行</text></view>
      <scroll-view class="sales-tabs" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="sales-tab {{salesZone === '' ? 'on' : ''}}" bindtap="onSalesZoneTap" data-zone="">全市</view>
        <view class="sales-tab {{salesZone === item ? 'on' : ''}}" wx:for="{{salesZones}}" wx:key="*this" bindtap="onSalesZoneTap" data-zone="{{item}}">{{item}}</view>
      </scroll-view>
      <view class="sales-list">
        <view class="sales-row" wx:for="{{salesRanks}}" wx:key="project_name"
              data-project="{{item.project_name}}" data-zone="{{item.zone}}"
              bindtap="onSalesRankTap" hover-class="sales-row-hover">
          <text class="sr-idx">{{index + 1}}</text>
          <view class="sr-info">
            <text class="sr-name">{{item.project_name}}</text>
            <text class="sr-zone">{{item.zone}}</text>
          </view>
          <text class="sr-count">{{item.sold_count}}套</text>
        </view>
      </view>
      <view class="sales-empty" wx:if="{{!salesRanks.length && !salesLoading}}">
        <text>数据收集中，同步开始后累积成交数据即显示</text>
      </view>
      <view class="sales-note">统计周期：近30天网签数据 · 数据来源：深圳市住房和建设局</view>
    </view>

    <!-- ═══ 月度成交走势 ═══ -->
    <view class="section">
      <view class="section-head"><text class="section-title">月度成交走势</text></view>
      <view class="range-bar">
        <view class="range-tab {{range === item.value ? 'on' : ''}}" wx:for="{{ranges}}" wx:key="value" data-value="{{item.value}}" bindtap="onRangeTap">{{item.label}}</view>
      </view>
      <view class="trend-chart">
        <view class="trend-row" wx:for="{{trends}}" wx:key="month">
          <text class="tr-month">{{item.monthLabel}}</text>
          <view class="tr-bar-wrap">
            <view class="tr-bar-new" style="width:{{item.new / trends[trends.length-1].total * 100}}%"></view>
            <view class="tr-bar-used" style="width:{{item.used / trends[trends.length-1].total * 100}}%"></view>
          </view>
          <text class="tr-count">{{item.total}}套</text>
        </view>
      </view>
      <view class="trend-legend">
        <text class="dot new"></text><text>一手</text>
        <text class="dot used"></text><text>二手</text>
      </view>
    </view>

    <!-- ═══ 近期日成交 ═══ -->
    <view class="section">
      <view class="section-head"><text class="section-title">近期日成交</text></view>
      <view class="tx-list">
        <view class="tx-item" wx:for="{{dailyItems}}" wx:key="date">
          <text class="tx-date">{{item.date}}</text>
          <text class="tx-new">一手 {{item.new}}套</text>
          <text class="tx-used">二手 {{item.used}}套</text>
          <text class="tx-total">共 {{item.total}}套</text>
        </view>
      </view>
    </view>

    <view class="note">数据来源：深圳开放数据平台 · 含一手+二手房</view>
  </view>
</view>

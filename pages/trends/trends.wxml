<view class="page">
  <view wx:if="{{loading && !summary}}" class="state-msg">加载中...</view>
  <view wx:if="{{error}}" class="err-block" bindtap="onRetry">
    <text class="err-icon">!</text>
    <text>加载失败，点击重试</text>
  </view>

  <view wx:if="{{summary}}">
    <!-- 本月概览 -->
    <view class="overview-hero">
      <text class="hero-num">{{summary.this_month.total}}</text>
      <text class="hero-label">本月成交（套）</text>
      <view class="hero-detail">
        <text class="hero-tag new">新房 {{summary.this_month.new}}</text>
        <text class="hero-tag used">二手 {{summary.this_month.used}}</text>
        <view class="hero-row">
          <text class="hero-tag {{summary.delta_mom_pct > 0 ? 'up' : 'down'}}">
            环比 {{summary.delta_mom_pct > 0 ? '+' : ''}}{{summary.delta_mom_pct}}%
          </text>
          <text class="hero-tag {{summary.delta_yoy_pct > 0 ? 'up' : 'down'}}" wx:if="{{summary.yoy_month}}">
            同比 {{summary.delta_yoy_pct > 0 ? '+' : ''}}{{summary.delta_yoy_pct}}%
          </text>
        </view>
      </view>
    </view>

    <!-- 月度走势 -->
    <view class="section">
      <view class="section-head"><text class="section-title">月度成交走势</text></view>
      <view class="range-bar">
        <view class="range-tab {{range === item.value ? 'on' : ''}}"
              wx:for="{{ranges}}" wx:key="value"
              data-value="{{item.value}}" bindtap="onRangeTap">{{item.label}}</view>
      </view>
      <view class="trend-chart">
        <view class="trend-row" wx:for="{{trends}}" wx:key="month">
          <text class="tr-month">{{item.monthLabel}}</text>
          <view class="tr-bar-wrap">
            <view class="tr-bar-new" style="width:{{item.new / trends[trends.length-1].total * 100}}%"></view>
            <view class="tr-bar-used" style="width:{{item.used / trends[trends.length-1].total * 100}}%"></view>
          </view>
          <text class="tr-count">{{item.total}}套</text>
        </view>
      </view>
      <view class="trend-legend">
        <text class="dot new"></text><text>新房</text>
        <text class="dot used"></text><text>二手</text>
      </view>
    </view>

    <!-- 近期日成交 -->
    <view class="section">
      <view class="section-head"><text class="section-title">近期日成交</text></view>
      <view class="tx-list">
        <view class="tx-item" wx:for="{{dailyItems}}" wx:key="date">
          <text class="tx-date">{{item.date}}</text>
          <text class="tx-new">新房 {{item.new}}套</text>
          <text class="tx-used">二手 {{item.used}}套</text>
          <text class="tx-total">共 {{item.total}}套</text>
        </view>
      </view>
    </view>

    <view class="data-note">数据来源：深圳开放数据平台 · 含新房+二手房</view>
    <view style="height:40rpx;"></view>
  </view>
</view>

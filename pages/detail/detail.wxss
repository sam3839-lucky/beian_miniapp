/* ═══ 房源详情 — WeUI 规范 ═══ */
.wrapper { background: #F7F7F7; min-height: 100vh; }
.sheet {
  background: #fff;
  border-radius: 8rpx 16rpx 0 0;
  margin: 40rpx 0 0;
  padding: 48rpx 0 40rpx;
}
.big-no {
  text-align: center;
  font-size: 64rpx;
  font-weight: 800;
  color: #333;
}
.big-subtitle {
  text-align: center;
  font-size: 26rpx;
  color: #888;
  margin: 4rpx 0 32rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.row .k { color: #888; }
.row .v { font-weight: 600; color: #333; }
.row .v.red { color: #FF4D4F; font-size: 40rpx; }

/* ═══ 月供计算器 ═══ */
.calc-card {
  background: #fff;
  margin: 32rpx;
  border-radius: 8rpx;
  padding: 32rpx;
}
.calc-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
}
.calc-row {
  margin-bottom: 24rpx;
}
.calc-label {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 12rpx;
  display: block;
}
.ratio-picker {
  display: flex;
  gap: 16rpx;
}
.ratio-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #333;
  background: #F7F7F7;
  border-radius: 8rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ratio-btn.on {
  background: #07C160;
  color: #fff;
  font-weight: 600;
}
.calc-price-tag {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF4D4F;
}
.calc-input {
  width: 100%;
  padding: 20rpx 24rpx;
  border-radius: 8rpx;
  border: 1rpx solid #E5E5E5;
  font-size: 28rpx;
  background: #F7F7F7;
  color: #333;
  height: 76rpx;
  box-sizing: border-box;
}
.discount-picker {
  display: flex;
  gap: 16rpx;
}
.picker-val {
  padding: 20rpx 24rpx;
  border-radius: 8rpx;
  border: 1rpx solid #E5E5E5;
  font-size: 28rpx;
  color: #333;
  background: #F7F7F7;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}
.calc-deal-tag {
  font-size: 36rpx;
  font-weight: 700;
  color: #07C160;
}
.calc-result {
  background: #F7F7F7;
  border-radius: 8rpx;
  padding: 24rpx;
}
.cr-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}
.cr-row + .cr-row {
  border-top: 1rpx solid #E5E5E5;
}
.cr-main {
  padding: 16rpx 0;
}
.cr-k {
  font-size: 28rpx;
  color: #888;
}
.cr-v {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}
.cr-v.big {
  font-size: 40rpx;
  color: #07C160;
  font-weight: 800;
}
.cr-note {
  text-align: right;
  font-size: 22rpx;
  color: #A8A8A8;
  margin-top: 12rpx;
}

/* ═══ 分享海报 ═══ */
.poster-bar {
  margin: 32rpx 32rpx 40rpx;
}
.poster-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  border: 2rpx solid #07C160;
}
.poster-btn-hover { background: #E8F8EF; }
.poster-icon { font-size: 32rpx; }

/* ═══ 关注项目 ═══ */
.follow-bar { margin: 32rpx 32rpx 0; }
.follow-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  border: 2rpx solid #FF8C00;
}
.follow-btn.on { border-color: #FF8C00; background: #FFF7E6; }
.follow-btn-hover { background: #FFF7E6; }
.follow-icon { font-size: 32rpx; }
.follow-hint { font-size: 22rpx; color: #888; margin-left: auto; }

/* ═══ 房源详情 — WeUI 规范 ═══ */
.wrapper { background: #F7F7F7; min-height: 100vh; }
.sheet {
  background: #fff;
  border-radius: 8rpx 16rpx 0 0;
  margin: 40rpx 0 0;
  padding: 48rpx 0 40rpx;
}
.big-no {
  text-align: center;
  font-size: 64rpx;
  font-weight: 800;
  color: #333;
}
.big-subtitle {
  text-align: center;
  font-size: 26rpx;
  color: #888;
  margin: 4rpx 0 32rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.row .k { color: #888; }
.row .v { font-weight: 600; color: #333; }
.row .v.red { color: #FF4D4F; font-size: 40rpx; }

/* ═══ 折扣计算器 ═══ */
.calc-card {
  background: #fff;
  margin: 32rpx;
  border-radius: 8rpx;
  padding: 32rpx;
  border-left: 8rpx solid #07C160;
}
.calc-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
}
.calc-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.calc-label {
  font-size: 26rpx;
  color: #888;
  flex-shrink: 0;
}
.calc-input {
  width: 80rpx;
  text-align: center;
  border: 2rpx solid #07C160;
  border-radius: 8rpx;
  padding: 12rpx 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #07C160;
}
.calc-unit {
  font-size: 24rpx;
  color: #888;
}
.calc-acts { display: flex; gap: 8rpx; flex:1; justify-content: flex-end; }
.calc-chip { font-size: 22rpx; padding: 8rpx 16rpx; border-radius: 40rpx; background: #F5F5F5; color: #666; }
.calc-chip.on { background: #07C160; color: #fff; font-weight: 600; }

.calc-result {
  background: #F9FAFB;
  border-radius: 8rpx;
  padding: 24rpx;
}
.cr-row { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid #F0F0F0; }
.cr-row:last-child { border-bottom: none; }
.cr-k { font-size: 26rpx; color: #888; }
.cr-v { font-size: 28rpx; font-weight: 700; color: #333; }
.cr-v.big { font-size: 36rpx; }
.cr-v.red { color: #FF4D4F; }
.cr-v.orange { color: #FF8C00; }
.calc-note { font-size: 22rpx; color: #999; margin-top: 16rpx; line-height: 1.6; }
  box-sizing: border-box;
}
/* ═══ 楼栋去化 ═══ */
.bld-card {
  background: #fff;
  margin: 32rpx;
  border-radius: 8rpx;
  padding: 32rpx;
}
.bld-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.bld-summary { font-size: 22rpx; color: #888; font-weight: 400; }
.bld-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F8F8F8;
}
.bld-row.on { background: #F0FDF4; margin: 0 -32rpx; padding: 14rpx 32rpx; }
.bld-row:last-child { border-bottom: none; }
.bld-info { width: 120rpx; flex-shrink: 0; }
.bld-tag { display: block; font-size: 24rpx; font-weight: 600; color: #333; }
.bld-sub { display: block; font-size: 18rpx; color: #888; }
.bld-wrap { flex: 1; display: flex; align-items: center; gap: 10rpx; }
.bld-track { flex: 1; height: 14rpx; background: #F0F0F0; border-radius: 7rpx; overflow: hidden; }
.bld-fill { height: 100%; border-radius: 7rpx; min-width: 4rpx; transition: width 0.3s; }
.bld-pct { width: 64rpx; text-align: right; font-size: 24rpx; font-weight: 700; flex-shrink: 0; }
.bld-sold { width: 80rpx; text-align: right; font-size: 20rpx; color: #888; flex-shrink: 0; }

/* ═══ 底部分享 ═══ */
.follow-bar {
.cr-note {
  text-align: right;
  font-size: 22rpx;
  color: #A8A8A8;
  margin-top: 12rpx;
}

/* ═══ 分享海报 ═══ */
.poster-bar {
  margin: 32rpx 32rpx 40rpx;
}
.poster-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  border: 2rpx solid #07C160;
}
.poster-btn-hover { background: #E8F8EF; }
.poster-icon { font-size: 32rpx; }

/* ═══ 关注项目 ═══ */
.follow-bar { margin: 32rpx 32rpx 0; }
.follow-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  border: 2rpx solid #FF8C00;
}
.follow-btn.on { border-color: #FF8C00; background: #FFF7E6; }
.follow-btn-hover { background: #FFF7E6; }
.follow-icon { font-size: 32rpx; }
.follow-hint { font-size: 22rpx; color: #888; margin-left: auto; }

<view class="sheet">
  <view class="big-no">{{unit.unit_no}}</view>
  <view class="big-subtitle">{{project}} · {{building}}</view>

  <view class="row"><text class="k">面积</text><text class="v">{{area}}㎡</text></view>
  <view class="row"><text class="k">单价</text><text class="v">{{unitPrice}}</text></view>
  <view class="row"><text class="k">总价</text><text class="v red">{{totalPrice}}</text></view>
</view>

<!-- ═══ 折扣计算器 ═══ -->
<view class="calc-card">
  <view class="calc-title">💰 折扣计算器</view>
  <view class="calc-row">
    <text class="calc-label">折扣</text>
    <input class="calc-input" type="digit" value="{{discount}}" bindinput="onDiscountInput" placeholder="85"/>
    <text class="calc-unit">%</text>
    <view class="calc-acts">
      <view class="calc-chip {{discount == 85 ? 'on' : ''}}" bindtap="onDiscountChip" data-v="{{85}}">85折</view>
      <view class="calc-chip {{discount == 90 ? 'on' : ''}}" bindtap="onDiscountChip" data-v="{{90}}">9折</view>
      <view class="calc-chip {{discount == 95 ? 'on' : ''}}" bindtap="onDiscountChip" data-v="{{95}}">95折</view>
      <view class="calc-chip {{discount == 100 ? 'on' : ''}}" bindtap="onDiscountChip" data-v="{{100}}">原价</view>
    </view>
  </view>
  <view class="calc-result">
    <view class="cr-row"><text class="cr-k">折后总价（{{discount}}折）</text><text class="cr-v big red">{{afterTotal}}</text></view>
    <view class="cr-row"><text class="cr-k">折后单价</text><text class="cr-v">{{afterUnit}}</text></view>
    <view class="cr-row"><text class="cr-k">首付 15%</text><text class="cr-v orange">{{afterDown15}}</text></view>
    <view class="cr-row"><text class="cr-k">月供 30年</text><text class="cr-v">{{calcMonthly}}</text></view>
  </view>
  <view class="calc-note">💡 售价不低于备案价85%，最低可打85折 · 按LPR {{mortgageRateText}} 等额本息</view>
</view>

<!-- ═══ 楼栋去化 ═══ -->
<view class="bld-card" wx:if="{{bldStats.length}}">
  <view class="bld-head">
    <text>🏗️ 楼栋去化情况</text>
    <text class="bld-summary">{{bldStats.length}}栋 · 已售{{bldTotalSold}}套</text>
  </view>
  <view class="bld-row {{bldActive === item.building ? 'on' : ''}}" wx:for="{{bldStats}}" wx:key="building"
        data-building="{{item.building}}" bindtap="onBldRowTap">
    <view class="bld-info">
      <text class="bld-tag">{{item.building}}</text>
      <text class="bld-sub">{{item.total}}套</text>
    </view>
    <view class="bld-wrap">
      <view class="bld-track">
        <view class="bld-fill" style="width:{{item.pct}}%;background:{{item.pct > 90 ? '#FF4D4F' : item.pct > 50 ? '#FF8C00' : '#CCC'}}"></view>
      </view>
      <text class="bld-pct" style="color:{{item.pct > 90 ? '#FF4D4F' : item.pct > 50 ? '#FF8C00' : '#999'}}">{{item.pct}}%</text>
    </view>
    <text class="bld-sold">{{item.sold}}/{{item.total}}</text>
  </view>
</view>

<!-- ═══ 关注项目 ═══ -->
<view class="follow-bar" wx:if="{{project}}">
  <view class="follow-btn {{subscribed ? 'on' : ''}}" bindtap="onToggleFollow" hover-class="follow-btn-hover">
    <text class="follow-icon">{{subscribed ? '🔔' : '🔕'}}</text>
    <text>{{subscribed ? '已关注' : '关注此项目'}}</text>
    <text wx:if="{{!subscribed}}" class="follow-hint">有新动向第一时间通知</text>
  </view>
</view>

<!-- ═══ 分享海报 ═══ -->
<view class="poster-bar" wx:if="{{project}}">
  <view class="poster-btn" bindtap="onSharePoster" hover-class="poster-btn-hover">
    <text class="poster-icon">📊</text>
    <text>生成分享海报</text>
  </view>
</view>

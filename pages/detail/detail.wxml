<view class="sheet">
  <view class="big-no">{{unit.unit_no}}</view>
  <view class="big-subtitle">{{project}} · {{building}}</view>

  <view class="row"><text class="k">面积</text><text class="v">{{area}}㎡</text></view>
  <view class="row"><text class="k">单价</text><text class="v">{{unitPrice}}</text></view>
  <view class="row"><text class="k">总价</text><text class="v red">{{totalPrice}}</text></view>
</view>

<!-- ═══ 月供计算器 ═══ -->
<view class="calc-card">
  <view class="calc-title">月供计算</view>
  <view class="calc-row">
    <view class="calc-field">
      <text class="calc-label">备案总价 {{totalPrice}}</text>
    </view>
  </view>
  <view class="calc-row">
    <view class="calc-field">
      <text class="calc-label">折扣</text>
      <picker mode="selector" range="{{discountOptions}}" value="{{discountIdx}}" bindchange="onDiscountChange">
        <view class="picker-val">{{discount > 0 ? discount + '折' : '无折扣'}}</view>
      </picker>
    </view>
  </view>
  <view class="calc-row" wx:if="{{dealPrice}}">
    <view class="calc-field">
      <text class="calc-label">成交总价</text>
      <text class="calc-deal-tag">{{dealPrice}}万</text>
    </view>
  </view>
  <view class="calc-row">
    <view class="calc-field">
      <text class="calc-label">首付比例</text>
      <view class="ratio-picker">
        <view class="ratio-btn {{calcRatio === 15 ? 'on' : ''}}" bindtap="onRatioTap" data-ratio="{{15}}">15%</view>
        <view class="ratio-btn {{calcRatio === 20 ? 'on' : ''}}" bindtap="onRatioTap" data-ratio="{{20}}">20%</view>
        <view class="ratio-btn {{calcRatio === 30 ? 'on' : ''}}" bindtap="onRatioTap" data-ratio="{{30}}">30%</view>
        <view class="ratio-btn {{calcRatio === 50 ? 'on' : ''}}" bindtap="onRatioTap" data-ratio="{{50}}">50%</view>
      </view>
    </view>
  </view>
  <view class="calc-result">
    <view class="cr-row">
      <text class="cr-k">首付</text>
      <text class="cr-v">{{calcDown}}万</text>
    </view>
    <view class="cr-row">
      <text class="cr-k">贷款</text>
      <text class="cr-v">{{calcLoan}}万</text>
    </view>
    <view class="cr-row cr-main">
      <text class="cr-k">月供</text>
      <text class="cr-v big">{{calcMonthly}}万</text>
    </view>
    <view class="cr-note">按LPR {{mortgageRateText}} · 30年期等额本息</view>
  </view>
</view>

<!-- ═══ 关注项目 ═══ -->
<view class="follow-bar" wx:if="{{project}}">
  <view class="follow-btn {{subscribed ? 'on' : ''}}" bindtap="onToggleFollow" hover-class="follow-btn-hover">
    <text class="follow-icon">{{subscribed ? '🔔' : '🔕'}}</text>
    <text>{{subscribed ? '已关注' : '关注此项目'}}</text>
    <text wx:if="{{!subscribed}}" class="follow-hint">有新动向第一时间通知</text>
  </view>
</view>

<!-- ═══ 分享海报 ═══ -->
<view class="poster-bar" wx:if="{{project}}">
  <view class="poster-btn" bindtap="onSharePoster" hover-class="poster-btn-hover">
    <text class="poster-icon">📊</text>
    <text>生成分享海报</text>
  </view>
</view>

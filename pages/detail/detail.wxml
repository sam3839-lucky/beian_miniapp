<view class="sheet">
  <view class="big-no">{{unit.unit_no}}</view>
  <view class="big-status" style="color:{{statusColor}}">● {{status}}</view>

  <view class="row"><text class="k">面积</text><text class="v">{{area}}㎡</text></view>
  <view class="row"><text class="k">单价</text><text class="v">{{unitPrice}}</text></view>
  <view class="row"><text class="k">总价</text><text class="v red">{{totalPrice}}</text></view>
  <view class="row"><text class="k">备案日期</text><text class="v">{{unit.check_date || '-'}}</text></view>
  <view class="row"><text class="k">用途</text><text class="v">{{unit.house_usage || '-'}}</text></view>
  <view class="row"><text class="k">类型</text><text class="v">{{unit.sale_type || '-'}}</text></view>
  <view class="row"><text class="k">楼栋</text><text class="v">{{project}} · {{building}}</text></view>
</view>

<!-- ═══ 月供计算器 ═══ -->
<view class="calc-card">
  <view class="calc-title">月供计算</view>
  <view class="calc-row">
    <view class="calc-field">
      <text class="calc-label">备案总价</text>
      <text class="calc-price-tag">{{totalPrice}}</text>
    </view>
  </view>
  <view class="calc-row">
    <view class="calc-field">
      <text class="calc-label">成交总价（万）</text>
      <input class="calc-input" type="digit" placeholder="输入实际成交价" value="{{dealPrice}}" bindinput="onDealPriceInput"/>
    </view>
  </view>
  <view class="calc-row">
    <view class="calc-field">
      <text class="calc-label">首付比例</text>
      <view class="ratio-picker">
        <view class="ratio-btn {{calcRatio === 15 ? 'on' : ''}}" bindtap="onRatioTap" data-ratio="{{15}}">15%</view>
        <view class="ratio-btn {{calcRatio === 20 ? 'on' : ''}}" bindtap="onRatioTap" data-ratio="{{20}}">20%</view>
        <view class="ratio-btn {{calcRatio === 30 ? 'on' : ''}}" bindtap="onRatioTap" data-ratio="{{30}}">30%</view>
        <view class="ratio-btn {{calcRatio === 50 ? 'on' : ''}}" bindtap="onRatioTap" data-ratio="{{50}}">50%</view>
      </view>
    </view>
  </view>
  <view class="calc-result">
    <view class="cr-row">
      <text class="cr-k">首付</text>
      <text class="cr-v">{{calcDown}}万</text>
    </view>
    <view class="cr-row">
      <text class="cr-k">贷款</text>
      <text class="cr-v">{{calcLoan}}万</text>
    </view>
    <view class="cr-row cr-main">
      <text class="cr-k">月供</text>
      <text class="cr-v big">{{calcMonthly}}万</text>
    </view>
    <view class="cr-note">按LPR 3.15% · 30年期等额本息</view>
  </view>
</view>

.page { background: #F7F7F7; min-height: 100vh; padding-bottom: 40rpx; }

/* 骨架 */
.loading-skel { padding: 24rpx; }
.skel-price { height: 160rpx; background: #eee; border-radius: 8rpx; margin-bottom: 16rpx; }
.skel-card { height: 260rpx; background: #eee; border-radius: 8rpx; margin-bottom: 16rpx; }

/* 错误 */
.err-block { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; font-size: 28rpx; color: #999; }
.err-icon { font-size: 64rpx; margin-bottom: 20rpx; }
.back-link { color: #07C160; margin-top: 16rpx; }

/* 价格头部 */
.price-header { margin: 16rpx 24rpx; background: linear-gradient(135deg, rgba(7,193,96,0.08), rgba(7,193,96,0.02)); border-radius: 12rpx; padding: 32rpx; text-align: center; }
.ph-total { font-size: 56rpx; font-weight: 800; color: #333; }
.ph-total.na { font-size: 36rpx; font-weight: 600; color: #bbb; }
.ph-wan { font-size: 28rpx; font-weight: 600; color: #666; }
.ph-unit { font-size: 28rpx; color: #07C160; font-weight: 600; display: block; margin-top: 6rpx; }

/* 卡片 */
.card { background: #fff; margin: 0 24rpx 16rpx; border-radius: 8rpx; overflow: hidden; }
.card-title { font-size: 28rpx; font-weight: 700; color: #333; padding: 24rpx 24rpx 12rpx; }
.info-row { display: flex; justify-content: space-between; padding: 16rpx 24rpx; border-bottom: 1rpx solid #F5F5F5; }
.info-row:last-child { border-bottom: none; }
.ilabel { font-size: 26rpx; color: #999; flex-shrink: 0; }
.ivalue { font-size: 26rpx; color: #333; text-align: right; font-weight: 500; }
.ivalue.price { color: #07C160; font-weight: 700; }

/* 近期成交 */
.recent-row { display: flex; align-items: center; padding: 12rpx 24rpx; border-bottom: 1rpx solid #F5F5F5; font-size: 24rpx; }
.recent-row:last-child { border-bottom: none; }
.r-date { color: #999; width: 120rpx; flex-shrink: 0; }
.r-info { flex: 1; color: #333; margin-left: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.r-price { color: #07C160; font-weight: 600; flex-shrink: 0; margin-left: 8rpx; }
.r-price.na { color: #bbb; font-weight: 400; }
.r-total { color: #999; flex-shrink: 0; width: 80rpx; text-align: right; margin-left: 8rpx; }
.view-all { text-align: center; padding: 16rpx; font-size: 26rpx; color: #07C160; }
.overview-entry { margin: 0 24rpx 16rpx; background: #fff; border-radius: 8rpx; padding: 20rpx; text-align: center; }
.oe-text { font-size: 28rpx; color: #07C160; font-weight: 600; }

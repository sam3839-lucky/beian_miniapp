.page { background: #F7F7F7; min-height: 100vh; padding-bottom: 60rpx; }

/* 头部 */
.header { background: #fff; padding: 40rpx 32rpx 32rpx; text-align: center; }
.h-title { font-size: 40rpx; font-weight: 700; color: #333; display: block; }
.h-sub { font-size: 26rpx; color: #888; margin-top: 12rpx; display: block; }

/* 账单切换 */
.billing-switch { padding: 24rpx 32rpx; display: flex; align-items: center; gap: 24rpx; background: #fff; }
.bs-track { width: 88rpx; height: 44rpx; background: #E5E5E5; border-radius: 22rpx; position: relative; flex-shrink: 0; }
.bs-thumb { width: 36rpx; height: 36rpx; background: #07C160; border-radius: 50%; position: absolute; top: 4rpx; transition: left 0.2s; }
.bs-thumb.left { left: 4rpx; }
.bs-thumb.right { left: 48rpx; }
.bs-labels { display: flex; gap: 32rpx; font-size: 26rpx; color: #888; }
.bs-labels text { color: #888; }
.bs-labels .on { color: #07C160; font-weight: 600; }

/* 三档卡片 */
.tiers { display: flex; gap: 12rpx; padding: 20rpx 32rpx; background: #fff; }
.tier-card { flex: 1; background: #F7F7F7; border-radius: 12rpx; padding: 24rpx 16rpx; text-align: center; position: relative; }
.tier-card.pro { background: #07C160; }
.tier-card.pro .tc-name,
.tier-card.pro .tc-price,
.tier-card.pro .tc-desc,
.tier-card.pro .tc-unit { color: #fff; }
.tc-badge { position: absolute; top: -12rpx; left: 50%; transform: translateX(-50%); background: #FF8C00; color: #fff; font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 10rpx; font-weight: 600; }
.tc-name { font-size: 26rpx; color: #333; font-weight: 600; display: block; margin-bottom: 8rpx; }
.tc-price { font-size: 48rpx; font-weight: 700; color: #333; display: block; line-height: 1.1; }
.tc-unit { font-size: 22rpx; font-weight: 400; color: #888; }
.tc-desc { font-size: 20rpx; color: #888; margin-top: 8rpx; display: block; }

/* 功能对比表 */
.feature-table { margin: 12rpx 32rpx; background: #fff; border-radius: 8rpx; overflow: hidden; }
.ft-header { display: flex; align-items: center; padding: 20rpx 24rpx 14rpx; border-bottom: 1rpx solid #E5E5E5; }
.fth-name { width: 140rpx; font-size: 24rpx; color: #A8A8A8; flex-shrink: 0; }
.fth-tier { flex: 1; text-align: center; font-size: 24rpx; color: #A8A8A8; }
.pro-col { color: #07C160; font-weight: 600; }
.ft-row { display: flex; align-items: center; padding: 18rpx 24rpx; border-bottom: 1rpx solid #F5F5F5; }
.ft-row:last-child { border-bottom: none; }
.ftr-name { width: 140rpx; font-size: 26rpx; color: #333; flex-shrink: 0; }
.ftr-val { flex: 1; text-align: center; font-size: 24rpx; color: #666; }

/* CTA */
.cta-section { margin: 32rpx; }
.cta-title { font-size: 28rpx; font-weight: 600; color: #333; display: block; margin-bottom: 16rpx; }
.cta-card { background: #fff; border-radius: 8rpx; padding: 24rpx; }
.cta-step { font-size: 26rpx; color: #333; display: block; padding: 8rpx 0; }
.cta-wechat { font-size: 36rpx; font-weight: 700; color: #07C160; display: block; padding: 12rpx 0; text-align: center; letter-spacing: 2rpx; }
.cta-copy { background: #07C160; color: #fff; font-size: 28rpx; text-align: center; padding: 20rpx; border-radius: 8rpx; margin: 16rpx 0; }
.cta-copy-hover { background: #06AD56; }

.footer-note { text-align: center; font-size: 22rpx; color: #A8A8A8; padding: 0 32rpx; }

<view class="page">
  <!-- ═══ P0: 搜索栏 ═══ -->
  <view class="search-bar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜项目名、开发商…" value="{{search}}"
             bindinput="onSearchInput" bindconfirm="onQuickSearch" confirm-type="search"
             focus="{{searchFocus}}"/>
    </view>
    <view class="search-clear" wx:if="{{search}}" bindtap="onClearSearch">
      <text>✕</text>
    </view>
  </view>

  <!-- ═══ 瞬搜结果 ═══ -->
  <view class="quick-results" wx:if="{{search && !searchLoading}}">
    <view class="qr-list" wx:if="{{searchResults.length}}">
      <view class="qr-card" wx:for="{{searchResults}}" wx:key="project_name"
            data-project="{{item.project_name}}" data-zone="{{item.zone}}"
            bindtap="onQuickResultTap" hover-class="qr-card-hover">
        <view class="qr-head">
          <text class="qr-name">{{item.project_name}}</text>
          <text class="qr-tag {{item.sale_type === '预售' ? 'tag-pre' : 'tag-spot'}}">{{item.sale_type}}</text>
          <text class="qr-zone">{{item.zone}}</text>
        </view>
        <view class="qr-stats">
          <view class="qr-stat">
            <text class="qr-snum">{{item.unsold_count}}</text>
            <text class="qr-slabel">可售套</text>
          </view>
          <view class="qr-stat">
            <text class="qr-snum">{{item.avg_unit_w}}</text>
            <text class="qr-slabel">万/㎡</text>
          </view>
          <view class="qr-stat">
            <text class="qr-snum">{{item.price_min}}-{{item.price_max}}</text>
            <text class="qr-slabel">万</text>
          </view>
        </view>
      </view>
    </view>
    <view class="qr-empty" wx:if="{{!searchResults.length && searchTapped}}">
      <text>未找到匹配项目，试试输入区域名或开发商名</text>
    </view>
    <view class="qr-history" wx:if="{{!searchResults.length && !searchTapped}}">
      <view wx:if="{{searchHistory.length}}">
        <text class="qh-title">最近搜索</text>
        <view class="qh-item" wx:for="{{searchHistory}}" wx:key="*this"
              bindtap="onHistoryTap" data-kw="{{item}}">{{item}}</view>
      </view>
    </view>
  </view>

  <!-- ═══ 用量提示 ═══ -->

  <!-- ═══ 行情 Hero 卡片 ═══ -->
  <view class="hero-card" wx:if="{{!search}}">
    <view class="hero-title">深圳 · 一手房</view>
    <view class="hero-stats">
      <view class="hero-stat">
        <text class="hs-val">{{hero.totalListings}}</text>
        <text class="hs-lbl">备案房源</text>
      </view>
      <view class="hero-stat">
        <text class="hs-val">{{hero.permits}}</text>
        <text class="hs-lbl">预售证</text>
      </view>
      <view class="hero-stat">
        <text class="hs-val">{{hero.todayNew}}</text>
        <text class="hs-lbl">今日新增</text>
      </view>
    </view>
  </view>

  <!-- ═══ 入口宫格 ═══ -->
  <view class="entry-grid" wx:if="{{!search}}">
    <view class="entry-item" bindtap="onEntryTap" data-page="map">
      <view class="entry-icon ei-green">🗺️</view>
      <text class="entry-label">地图找房</text>
    </view>
    <view class="entry-item" bindtap="onEntryTap" data-page="new">
      <view class="entry-icon ei-blue">🏠</view>
      <text class="entry-label">新房查询</text>
    </view>
    <view class="entry-item" bindtap="onEntryTap" data-page="upcoming">
      <view class="entry-icon ei-orange">🔥</view>
      <text class="entry-label">即将入市</text>
    </view>
    <view class="entry-item" bindtap="onEntryTap" data-page="trends">
      <view class="entry-icon ei-red">📈</view>
      <text class="entry-label">成交趋势</text>
    </view>
    <view class="entry-item" bindtap="onEntryTap" data-page="mortgage">
      <view class="entry-icon ei-green">💰</view>
      <text class="entry-label">房贷计算</text>
    </view>
    <view class="entry-item" bindtap="onEntryTap" data-page="policy">
      <view class="entry-icon ei-blue">📋</view>
      <text class="entry-label">政策速递</text>
    </view>
  </view>

  <!-- ═══ P0: 市场概览卡片 ═══ -->
  <view class="overview-skel" wx:if="{{!overview && !overviewError}}">
    <view class="skel-card"></view><view class="skel-card"></view>
    <view class="skel-card"></view><view class="skel-card"></view>
  </view>
  <view class="err-block" wx:if="{{overviewError}}" bindtap="onRetryOverview">
    <text class="err-icon">!</text>
    <text>数据加载失败，点击重试</text>
  </view>
  <view class="overview" wx:if="{{overview}}">
    <view class="stat-card stat-card-primary">
      <text class="stat-num">{{overview.unsold_n}}<text class="stat-unit">套</text></text>
      <text class="stat-label">总可售</text>
    </view>
    <view class="stat-card">
      <text class="stat-num presale">{{overview.presale_n}}<text class="stat-unit">套</text></text>
      <text class="stat-label">预售</text>
      <text class="stat-sub">期房</text>
    </view>
    <view class="stat-card">
      <text class="stat-num spot">{{overview.spot_sale_n}}<text class="stat-unit">套</text></text>
      <text class="stat-label">现售</text>
      <text class="stat-sub">现房</text>
    </view>
    <view class="stat-card stat-card-price">
      <text class="stat-num price">{{overview.avg_unit_price_w}}<text class="stat-unit">万/㎡</text></text>
      <text class="stat-label">住宅均价</text>
    </view>
  </view>

  <!-- 状态占比条 -->
  <view class="status-bar" wx:if="{{overview}}">
    <view class="bar-track">
      <view class="bar-seg unsold" style="width:{{overview.unsold / overview.total * 100}}%"></view>
      <view class="bar-seg signed" style="width:{{overview.signed / overview.total * 100}}%"></view>
      <view class="bar-seg filed" style="width:{{overview.filed / overview.total * 100}}%"></view>
      <view class="bar-seg transferred" style="width:{{overview.transferred / overview.total * 100}}%"></view>
    </view>
    <view class="bar-legend">
      <view class="legend-item">
        <text class="dot unsold"></text><text class="legend-label">未售</text>
        <text class="legend-val">{{overview.unsold_w}}万</text>
      </view>
      <view class="legend-item">
        <text class="dot signed"></text><text class="legend-label">网签</text>
        <text class="legend-val">{{overview.signed_w}}万</text>
      </view>
      <view class="legend-item">
        <text class="dot filed"></text><text class="legend-label">备案</text>
        <text class="legend-val">{{overview.filed_w}}万</text>
      </view>
      <view class="legend-item">
        <text class="dot transferred"></text><text class="legend-label">转移</text>
        <text class="legend-val">{{overview.transferred_w}}万</text>
      </view>
    </view>
  </view>


  <!-- ═══ P1: 各区新房可售房源 ═══ -->
  <view class="section" wx:if="{{overview && overview.zones.length}}">
    <view class="section-head">
      <text class="section-title">各区新房可售房源</text>
    </view>
    <view class="zone-compare">
      <view class="zone-row" wx:for="{{overview.zones}}" wx:key="name"
            data-zone="{{item.name}}" bindtap="onZoneTap" hover-class="zone-row-hover">
        <view class="z-head">
          <text class="zname">{{item.name}}</text>
          <text class="zcount">{{item.count}}<text class="zunit">套</text></text>
          <text class="zavg">{{item.avg_total}}<text class="zunit">万/套</text></text>
          <text class="zrank">#{{index + 1}}</text>
        </view>
        <view class="zbar-wrap">
          <view class="zbar-presale" style="width:{{item.presale / overview.zones[0].count * 100}}%"></view>
          <view class="zbar-spot" style="width:{{item.spot_sale / overview.zones[0].count * 100}}%"></view>
        </view>
        <view class="z-foot">
          <view class="z-tag tag-presale">期房 {{item.presale}}</view>
          <view class="z-tag tag-spot">现房 {{item.spot_sale}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- ═══ P1: 榜单 ═══ -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">排行榜</text>
    </view>
    <view class="rank-tabs">
      <view class="rank-tab {{rankTab === index ? 'on' : ''}}"
            wx:for="{{rankTabs}}" wx:key="*this"
            data-index="{{index}}" bindtap="onRankTabChange" hover-class="rank-tap-active">{{item}}</view>
    </view>
    <view class="rank-list">
      <block wx:if="{{rankList.length}}">
        <view class="rank-item" wx:for="{{rankList}}" wx:key="unit_api_id"
              data-item="{{item}}" bindtap="onRankItemTap" hover-class="rank-item-hover">
          <text class="rank-idx">{{index + 1}}</text>
          <view class="rank-info">
            <view class="rank-proj-row">
              <text class="rank-proj">{{item.project_name}}</text>
              <text class="rank-zone" wx:if="{{item.zone}}">{{item.zone}}</text>
            </view>
            <text class="rank-unit">{{item.unit_no}}  |  {{item.built_area}}㎡</text>
          </view>
          <view class="rank-price">
            <text class="rp-unit">{{item.unitPriceWan}}万/㎡</text>
            <text class="rp-total">{{item.total_price}}万</text>
          </view>
        </view>
      </block>
      <view wx:elif="{{rankingsError}}" class="err-block" bindtap="onRetryRankings">
        <text class="err-icon">!</text>
        <text>排行榜加载失败，点击重试</text>
      </view>
      <view wx:else class="state-msg">加载中...</view>
    </view>
  </view>

  <!-- ═══ 本周去化最快 ═══ -->
  <view class="section" wx:if="{{topAbsorption.length}}">
    <view class="section-head">
      <text class="section-title">本周去化最快 Top 3</text>
    </view>
    <view class="top-list">
      <view class="top-row" wx:for="{{topAbsorption}}" wx:key="project_name"
            data-project="{{item.project_name}}" bindtap="onTopAbsorptionTap">
        <view class="top-rank rk-{{index + 1}}">{{index + 1}}</view>
        <view class="top-info">
          <text class="top-name">{{item.project_name}}</text>
          <text class="top-zone">{{item.zone}}</text>
        </view>
        <view class="top-right">
          <text class="top-rate" style="color:{{item.pct > 90 ? '#FF4D4F' : item.pct > 50 ? '#FF8C00' : '#999'}}">{{item.pct}}%</text>
          <text class="top-sold">{{item.sold_count}}套</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ═══ P2: 最新预售证 ═══ -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">最新预售证</text>
    </view>
    <view wx:if="{{permitsError}}" class="err-block" bindtap="onRetryPermits">
      <text class="err-icon">!</text>
      <text>预售证加载失败，点击重试</text>
    </view>
    <scroll-view wx:elif="{{permits.length}}" class="permit-scroll" scroll-x enhanced enable-flex show-scrollbar="{{false}}">
      <view class="permit-card" wx:for="{{permits}}" wx:key="project_name"
            data-project="{{item.project_name}}" data-zone="{{item.zone}}" bindtap="onPermitTap" hover-class="permit-card-hover">
        <text class="pm-zone">{{item.zone}}</text>
        <text class="pm-name">{{item.project_name}}</text>
        <text class="pm-dev">{{item.developer}}</text>
        <text class="pm-date">{{item.pass_date}}</text>
        <text class="pm-count" wx:if="{{item.unsold}}">可售 {{item.unsold}} 套</text>
      </view>
    </scroll-view>
  </view>

  <!-- ═══ P3: 购房能力计算器 ═══ -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">购房能力计算</text>
    </view>
    <view class="calc-card">
      <view class="calc-row">
        <view class="calc-field">
          <text class="calc-label">首付预算（万）</text>
          <input class="calc-input" type="digit" placeholder="如 150"
                 value="{{calc.downPayment}}" data-field="downPayment" bindinput="onCalcInput"/>
        </view>
        <view class="calc-field">
          <text class="calc-label">月供能力（万）</text>
          <input class="calc-input" type="digit" placeholder="如 1.5"
                 value="{{calc.monthlyPayment}}" data-field="monthlyPayment" bindinput="onCalcInput"/>
        </view>
      </view>
      <view class="calc-btn" bindtap="onCalcSubmit" hover-class="calc-btn-hover">计算可负担总价</view>
      <view class="calc-result" wx:if="{{calc.result}}" bindtap="onCalcResultTap">
        <view class="cr-row">
          <text>首付30%可买总价</text>
          <text class="cr-val">{{calc.result.totalLow}}万 ~ {{calc.result.totalHigh}}万</text>
        </view>
        <view class="cr-row">
          <text>月供{{calc.monthlyPayment}}万最高可贷</text>
          <text class="cr-val">{{calc.result.affordMax}}万</text>
        </view>
        <view class="cr-hint">点击查看可购房源 →</view>
      </view>
    </view>
  </view>

  <!-- ═══ AI 每日解读 ═══ -->
  <view class="ai-card" wx:if="{{!search && aiText}}">
    <view class="ai-head">🤖 AI 每日解读</view>
    <text class="ai-body">{{aiText}}</text>
  </view>

  <view style="height:80rpx;"></view>
</view>

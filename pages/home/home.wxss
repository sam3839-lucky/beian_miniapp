/* ═══ 主页样式 — 微信小程序 WeUI 规范 ═══ */
/* 750rpx = 屏幕宽度 | 色系: WeUI | 圆角: 8rpx | 间距: 16/24/32rpx 网格 */

.page {
  background: #F7F7F7;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ═══ 搜索栏 ═══ */
.search-bar {
  background: #fff;
  padding: 16rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.search-box {
  display: flex;
  align-items: center;
  background: #F7F7F7;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  height: 72rpx;
  box-sizing: border-box;
  flex: 1;
}
.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
}
.search-clear {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #E5E5E5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #888;
}

/* ═══ 瞬搜结果 ═══ */
.quick-results {
  background: #fff;
  margin: 0 0 16rpx;
}
.qr-card {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.qr-card:last-child { border-bottom: none; }
.qr-card-hover { background: #F7F7F7; }
.qr-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.qr-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}
.qr-zone {
  font-size: 22rpx;
  color: #07C160;
  background: rgba(7, 193, 96, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}
.qr-tag { font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 4rpx; font-weight: 600; flex-shrink: 0; }
.tag-pre { background: #E8F8EE; color: #059669; }
.tag-spot { background: #FFF3E6; color: #D97706; }
.qr-stats {
  display: flex;
  gap: 8rpx;
}
.qr-stat {
  flex: 1;
  background: #F7F7F7;
  border-radius: 8rpx;
  padding: 16rpx 12rpx;
  text-align: center;
}
.qr-snum {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.2;
}
.qr-slabel {
  display: block;
  font-size: 20rpx;
  color: #888;
  margin-top: 4rpx;
}
.qr-empty {
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #888;
}
.qr-history {
  padding: 16rpx 32rpx 32rpx;
}
.qh-title {
  font-size: 24rpx;
  color: #A8A8A8;
  display: block;
  margin-bottom: 16rpx;
}
.qh-item {
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1rpx solid #F0F0F0;
}

/* ═══ Hero 卡片 ═══ */
.hero-card {
  margin: 16rpx 24rpx;
  background: linear-gradient(135deg, #1a2e1a, #0d1f0d);
  border-radius: 24rpx;
  padding: 32rpx;
  color: #fff;
}
.hero-title { font-size: 24rpx; font-weight: 600; opacity: 0.8; }
.hero-stats { display: flex; gap: 16rpx; margin-top: 20rpx; }
.hero-stat { flex: 1; text-align: center; }
.hs-val { display: block; font-size: 40rpx; font-weight: 800; }
.hs-lbl { display: block; font-size: 20rpx; opacity: 0.5; margin-top: 4rpx; }

/* ═══ 入口宫格 ═══ */
.entry-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin: 16rpx 24rpx;
}
.entry-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
}
.entry-item:active { background: #F5F5F5; }
.entry-icon {
  width: 72rpx; height: 72rpx; border-radius: 20rpx;
  margin: 0 auto 12rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
}
.ei-green { background: #E8F8EE; color: #07C160; }
.ei-blue  { background: #DBEAFE; color: #3B82F6; }
.ei-orange { background: #FFF3E6; color: #FF8C00; }
.ei-red   { background: #FFE5E5; color: #FF4D4F; }
.entry-label { font-size: 22rpx; color: #333; font-weight: 500; }

/* ═══ AI 解读 ═══ */
.ai-card {
  margin: 16rpx 24rpx;
  background: linear-gradient(135deg, #F0FDF4, #ECFEFF);
  border: 1px solid #A7F3D0;
  border-radius: 16rpx;
  padding: 24rpx;
}
.ai-head { font-size: 26rpx; font-weight: 700; color: #07C160; margin-bottom: 12rpx; }
.ai-body { font-size: 24rpx; color: #555; line-height: 1.8; }

/* ═══ 去化排行 ═══ */
.top-list {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
}
.top-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}
.top-row:last-child { border-bottom: none; }
.top-rank {
  width: 40rpx; height: 40rpx; border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 700; flex-shrink: 0;
  background: #F5F5F5; color: #999;
}
.rk-1 { background: #FFE5E5; color: #E53E3E; }
.rk-2 { background: #FFF3E6; color: #D97706; }
.rk-3 { background: #FFF7ED; color: #C2410C; }
.top-info { flex: 1; }
.top-name { display: block; font-size: 26rpx; font-weight: 600; color: #333; }
.top-zone { display: block; font-size: 20rpx; color: #888; margin-top: 4rpx; }
.top-right { text-align: right; flex-shrink: 0; }
.top-rate { display: block; font-size: 28rpx; font-weight: 700; }
.top-sold { display: block; font-size: 20rpx; color: #888; margin-top: 4rpx; }

/* ═══ 房价指数 ═══ */
.idx-card { background:#fff; margin:0 24rpx 8rpx; border-radius:16rpx; padding:24rpx; box-shadow:0 2rpx 12rpx rgba(0,0,0,.06); overflow:hidden; }
.seg-tabs { display:flex; gap:8rpx; margin-bottom:20rpx; }
.seg-tab { font-size:22rpx; padding:8rpx 16rpx; border-radius:40rpx; background:#F5F5F5; color:#666; }
.seg-tab.on { background:#07C160; color:#fff; font-weight:600; }
.idx-stats { display:flex; gap:8rpx; margin-bottom:20rpx; }
.idx-stat { flex:1; background:#F9FAFB; border-radius:8rpx; padding:16rpx 8rpx; text-align:center; }
.idx-sval { display:block; font-size:36rpx; font-weight:800; }
.idx-slbl { display:block; font-size:20rpx; color:#888; margin-top:4rpx; }
.idx-chart { display:flex; align-items:flex-end; gap:2rpx; height:180rpx; padding:0; position:relative; }
.idx-bar-wrap { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; min-width:0; }
.idx-bar { width:100%; border-radius:2rpx 2rpx 0 0; }
.idx-baseline { position:absolute; bottom:26rpx; left:0; right:0; height:1px; background:#E5E5E5; }
.idx-bar.up { background:#07C160; }
.idx-bar.down { background:#FF4D4F; }
.idx-bar-label { font-size:16rpx; font-weight:700; margin-bottom:4rpx; white-space:nowrap; }
.idx-bar-label.up { color:#059669; }
.idx-bar-label.down { color:#DC2626; }
.idx-months { display:flex; gap:2rpx; padding:0; overflow:hidden; }
.idx-mlabel { flex:1; text-align:center; font-size:14rpx; color:#BBB; min-width:0; }
.idx-source { text-align:center; font-size:18rpx; color:#BBB; margin-top:12rpx; }

/* ═══ 概览卡片 ═══ */
.overview {
  display: flex;
  padding: 20rpx 24rpx;
  gap: 12rpx;
}
.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 6rpx 16rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.stat-card-primary {
  background: linear-gradient(180deg, #F0FAF3 0%, #fff 100%);
}
.stat-card-price {
  background: linear-gradient(180deg, #FFF5F5 0%, #fff 100%);
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.2;
}
.stat-num.presale { color: #576B95; }
.stat-num.spot   { color: #FF8C00; }
.stat-num.price  { color: #FF4D4F; }
.stat-unit {
  font-size: 24rpx;
  font-weight: 500;
  margin-left: 2rpx;
}
.stat-label {
  font-size: 22rpx;
  color: #333;
  font-weight: 500;
}
.stat-sub {
  font-size: 18rpx;
  color: #A8A8A8;
}

/* ═══ 状态占比条 ═══ */
.status-bar {
  margin: 0 32rpx 32rpx;
  background: #fff;
  border-radius: 8rpx;
  padding: 24rpx 28rpx;
}
.bar-track {
  height: 16rpx;
  border-radius: 8rpx;
  background: #F0F0F0;
  display: flex;
  overflow: hidden;
}
.bar-seg { height: 100%; }
.bar-seg.unsold      { background: #07C160; }
.bar-seg.signed      { background: #FAAD14; }
.bar-seg.filed       { background: #FF8C00; }
.bar-seg.transferred { background: #D9D9D9; }
.bar-legend {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.legend-item {
  width: 50%;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 0;
  font-size: 24rpx;
}
.legend-label { color: #888; }
.legend-val { font-weight: 600; color: #333; }
.dot {
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  display: inline-block;
  margin-right: 4rpx;
}
.dot.unsold      { background: #07C160; }
.dot.signed      { background: #FAAD14; }
.dot.filed       { background: #FF8C00; }
.dot.transferred { background: #D9D9D9; }

/* ═══ Section 通用 ═══ */
.section {
  margin: 32rpx 32rpx 0;
}
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.zone-compare {
  background: #fff;
  border-radius: 12rpx;
  padding: 4rpx 28rpx;
}
.zone-row {
  padding: 18rpx 0;
}
.zone-row + .zone-row {
  border-top: 1rpx solid #F0F0F0;
}
.z-head {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 12rpx;
}
.zname {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  min-width: 80rpx;
}
.zcount {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}
.zunit {
  font-size: 20rpx;
  font-weight: 400;
  color: #A8A8A8;
  margin-left: 2rpx;
}
.zavg {
  font-size: 22rpx;
  color: #888;
  margin-left: auto;
}
.zrank {
  font-size: 20rpx;
  color: #D0D0D0;
  font-weight: 500;
  margin-left: 4rpx;
}
.zbar-wrap {
  display: flex;
  height: 8rpx;
  border-radius: 4rpx;
  overflow: hidden;
  background: #F5F5F5;
  margin-bottom: 10rpx;
}
.zbar-presale {
  height: 100%;
  background: #576B95;
  transition: width 0.4s ease;
}
.zbar-spot {
  height: 100%;
  background: #FF8C00;
  transition: width 0.4s ease;
}
.z-foot {
  display: flex;
  gap: 12rpx;
}
.z-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
}
.tag-presale {
  color: #576B95;
  background: #EEF1F6;
}
.tag-spot {
  color: #FF8C00;
  background: #FFF5EB;
}

/* ═══ 排行榜 Tabs ═══ */
.rank-tabs {
  display: flex;
  background: #fff;
  border-radius: 8rpx 8rpx 0 0;
}
.rank-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #888;
  border-bottom: 4rpx solid transparent;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rank-tab.on {
  color: #07C160;
  border-color: #07C160;
  font-weight: 600;
}

/* ═══ 排行榜列表 ═══ */
.rank-list {
  background: #fff;
  border-radius: 0 0 8rpx 8rpx;
  overflow: hidden;
}
.rank-item {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  gap: 20rpx;
  min-height: 88rpx;
  border-top: 1rpx solid #F0F0F0;
}
.rank-idx {
  font-size: 28rpx;
  font-weight: 700;
  color: #D9D9D9;
  width: 40rpx;
  text-align: center;
}
.rank-item:nth-child(1) .rank-idx { color: #FAAD14; }
.rank-item:nth-child(2) .rank-idx { color: #A8A8A8; }
.rank-item:nth-child(3) .rank-idx { color: #D97706; }
.rank-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.rank-proj-row { display: flex; align-items: center; gap: 10rpx; }
.rank-proj {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rank-zone {
  font-size: 20rpx;
  color: #07C160;
  background: rgba(7, 193, 96, 0.08);
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}
.rank-unit {
  font-size: 24rpx;
  color: #888;
}
.rank-price {
  text-align: right;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex-shrink: 0;
}
.rp-total {
  font-size: 30rpx;
  font-weight: 700;
  color: #FF4D4F;
}
.rp-unit {
  font-size: 22rpx;
  color: #888;
}

/* ═══ 预售证横向滚动 ═══ */
.permit-scroll {
  display: flex;
  flex-direction: row;
}
.permit-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  background: #fff;
  border-radius: 8rpx;
  padding: 24rpx 28rpx;
  margin-right: 16rpx;
  width: 320rpx;
  flex-shrink: 0;
}
.pm-zone {
  font-size: 20rpx;
  color: #07C160;
  background: #E8F8EF;
  align-self: flex-start;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
}
.pm-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pm-dev {
  font-size: 22rpx;
  color: #888;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pm-date {
  font-size: 22rpx;
  color: #888;
}
.pm-count {
  font-size: 24rpx;
  color: #FF4D4F;
  font-weight: 600;
}

/* ═══ 计算器 ═══ */
.calc-card {
  background: #fff;
  border-radius: 8rpx;
  padding: 28rpx;
}
.calc-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.calc-field {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.calc-label {
  font-size: 24rpx;
  color: #888;
}
.calc-input {
  padding: 20rpx 24rpx;
  border-radius: 8rpx;
  border: 1rpx solid #E5E5E5;
  font-size: 28rpx;
  background: #F7F7F7;
  color: #333;
  height: 76rpx;
  box-sizing: border-box;
}
.calc-btn {
  text-align: center;
  padding: 24rpx;
  background: #07C160;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.calc-result {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #E5E5E5;
}
.cr-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  font-size: 28rpx;
  color: #333;
}
.cr-val {
  font-weight: 600;
  color: #07C160;
  font-size: 30rpx;
}
.cr-hint {
  text-align: right;
  font-size: 22rpx;
  color: #07C160;
  margin-top: 12rpx;
}

/* ═══ 骨架屏 ═══ */
.overview-skel {
  display: flex;
  padding: 24rpx 32rpx;
  gap: 16rpx;
}
.skel-card {
  flex: 1;
  height: 120rpx;
  background: #E5E5E5;
  border-radius: 8rpx;
}

/* ═══ hover 态（微信原生反馈） ═══ */
.zone-row-hover  { background: #F7F7F7; }
.rank-item-hover { background: #F7F7F7; }
.rank-tap-active { opacity: 0.7; }
.permit-card-hover { background: #F7F7F7; }
.calc-btn-hover { background: #06AD56; }

/* ═══ 运营入口 ═══ */
.ops-entry {
  background: #fff;
  border-radius: 8rpx;
  padding: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #576B95;
  min-height: 88rpx;
}

/* ═══ 错误态 ═══ */
.err-block {
  background: #FFF7E6;
  border-radius: 8rpx;
  padding: 32rpx;
  text-align: center;
  color: #FAAD14;
  font-size: 28rpx;
  margin: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 88rpx;
}
.err-icon {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 50%;
  background: #FAAD14;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

/* ═══ 空态 ═══ */
.state-msg {
  text-align: center;
  padding: 48rpx 32rpx;
  color: #888;
  font-size: 28rpx;
}

.container { display:flex; flex-direction:column; height:100vh; background:#F7F7F7; }

/* 搜索栏 */
.search-bar { background: #fff; padding: 16rpx 32rpx; display: flex; align-items: center; gap: 16rpx; }
.search-box { display: flex; align-items: center; background: #F7F7F7; border-radius: 8rpx; padding: 20rpx 24rpx; height: 72rpx; box-sizing: border-box; flex: 1; }
.search-icon { font-size: 28rpx; margin-right: 16rpx; }
.search-keyword { flex: 1; font-size: 28rpx; color: #333; }
.search-clear { width: 56rpx; height: 56rpx; border-radius: 50%; background: #E5E5E5; display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #888; }

/* 瞬搜结果 */
.quick-results { background: #fff; }
.qr-card { padding: 24rpx 32rpx; border-bottom: 1rpx solid #F0F0F0; }
.qr-card:last-child { border-bottom: none; }
.qr-card-hover { background: #F7F7F7; }
.qr-head { display: flex; align-items: baseline; gap: 16rpx; margin-bottom: 16rpx; }
.qr-name { font-size: 30rpx; font-weight: 700; color: #333; }
.qr-zone { font-size: 22rpx; color: #07C160; background: rgba(7,193,96,0.08); padding: 4rpx 12rpx; border-radius: 4rpx; }
.qr-stats { display: flex; gap: 8rpx; }
.qr-stat { flex: 1; background: #F7F7F7; border-radius: 8rpx; padding: 16rpx 12rpx; text-align: center; }
.qr-snum { display: block; font-size: 32rpx; font-weight: 700; color: #333; }
.qr-slabel { display: block; font-size: 20rpx; color: #888; margin-top: 4rpx; }
.qr-empty { padding: 64rpx 32rpx; text-align: center; font-size: 26rpx; color: #888; }

/* 快速筛选 combo */
.quick-bar { background:#fff; padding:12rpx 28rpx; white-space:nowrap; display:flex; gap:12rpx; }
.quick-chip { display:inline-block; font-size:22rpx; padding:10rpx 24rpx; border-radius:40rpx; background:#F5F5F5; color:#666; flex-shrink:0; transition:all 0.15s; }
.quick-chip.on { background:#FFF3E6; color:#D97706; border:1px solid #FDE68A; font-weight:600; }

/* 筛选栏 */
.filters {
  background: #fff;
  padding: 8px 14px 10px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.filter-row {
  display: flex;
  gap: 8px;
}
.filter-row picker {
  flex: 1;
}
.picker-val {
  padding: 10px 14px;
  border-radius: 12px;
  border: 1px solid #E5E5E5;
  font-size: 14px;
  color: #333;
  background: #F7F7F7;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.search-input {
  flex: 1;
  padding: 10px 14px;
  border-radius: 12px;
  border: 1px solid #E5E5E5;
  font-size: 14px;
  background: #F7F7F7;
}

/* 统计标题 */
.bldg-title {
  padding: 4px 18px 10px;
  font-size: 13px;
  display: flex;
  align-items: baseline;
  gap: 8px;
}
.title-text {
  font-weight: 600;
  color: #888;
}
.stats-inline {
  font-weight: 500;
  color: #888;
  font-size: 12px;
}
.stats-inline .bold {
  color: #07C160;
  font-weight: 700;
}

/* 列表 */
.list {
  flex: 1;
  padding: 0 14px;
  overflow-y: auto;
}

/* 骨架屏 */
.skeleton {
  background: #fffefb;
  border-radius: 14px;
  padding: 14px 16px;
  margin-bottom: 6px;
  display: flex;
  gap: 14px;
}
.s-bar {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.s-line {
  height: 14px;
  border-radius: 6px;
  background: #E5E5E5;
}
.s-line.short { width: 60%; }

/* 状态提示 */
.state-msg {
  text-align: center;
  padding: 40px 20px;
  color: #888;
  font-size: 14px;
}

/* 楼层分隔 */
.floor-sep {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 16px 4px 8px;
}
.floor-sep .line {
  flex: 1;
  height: 1px;
  background: #E5E5E5;
}
.floor-sep .num {
  font-size: 12px;
  font-weight: 700;
  color: #888;
  letter-spacing: 1px;
}

/* 统计栏（筛选区内） */
.stat-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  text-align: center;
  padding: 10px 0 2px;
}
.item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1px;
}
.val {
  font-size: 24px;
  font-weight: 800;
  letter-spacing: -1px;
}
.val.t { color: #333; }
.val.s { color: #888; }
.val.u { color: #07C160; }
.lbl {
  font-size: 11px;
  color: #888;
  font-weight: 500;
  letter-spacing: .5px;
}
.sep {
  width: 1px;
  height: 32px;
  background: #f0efed;
}
.pct {
  font-size: 10px;
  color: #888;
  margin-top: 1px;
}

<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input class="search-keyword" placeholder="搜项目名、开发商…" value="{{quickSearch}}"
             bindinput="onQuickSearchInput" bindconfirm="onQuickSearchConfirm" confirm-type="search"/>
    </view>
    <view class="search-clear" wx:if="{{quickSearch}}" bindtap="onClearQuickSearch">
      <text>✕</text>
    </view>
  </view>

  <!-- 瞬搜结果 -->
  <view class="quick-results" wx:if="{{quickSearch && searchResults.length}}">
    <view class="qr-card" wx:for="{{searchResults}}" wx:key="project_name"
          data-project="{{item.project_name}}" data-zone="{{item.zone}}"
          bindtap="onQuickResultTap" hover-class="qr-card-hover">
      <view class="qr-head">
        <text class="qr-name">{{item.project_name}}</text>
        <text class="qr-zone">{{item.zone}}</text>
      </view>
      <view class="qr-stats">
        <view class="qr-stat">
          <text class="qr-snum">{{item.unsold_count}}</text>
          <text class="qr-slabel">可售套</text>
        </view>
        <view class="qr-stat">
          <text class="qr-snum">{{item.avg_unit_w}}</text>
          <text class="qr-slabel">万/㎡</text>
        </view>
        <view class="qr-stat">
          <text class="qr-snum">{{item.price_min}}-{{item.price_max}}</text>
          <text class="qr-slabel">万</text>
        </view>
      </view>
    </view>
  </view>
  <view class="qr-empty" wx:if="{{quickSearch && searchTapped && !searchResults.length}}">
    <text>未找到匹配项目，试试输入区域名</text>
  </view>

  <!-- 筛选栏（无搜索时显示） -->
  <view class="filters" wx:if="{{!quickSearch || !searchTapped}}">
    <view class="filter-row">
      <picker mode="selector" range="{{zones}}" value="{{zoneIdx}}" bindchange="onZoneChange">
        <view class="picker-val">{{zoneIdx === 0 ? '全深圳' : zones[zoneIdx]}}</view>
      </picker>
      <picker mode="selector" range="{{projects}}" range-key="name" value="{{projectIdx}}" bindchange="onProjectChange">
        <view class="picker-val">{{projectIdx === 0 ? '选择小区' : projects[projectIdx].name}}</view>
      </picker>
    </view>
    <view class="filter-row">
      <picker mode="selector" range="{{buildings}}" value="{{buildingIdx}}" bindchange="onBuildingChange">
        <view class="picker-val">{{buildingIdx === 0 ? '全部楼栋' : buildings[buildingIdx]}}</view>
      </picker>
      <input class="search-input" placeholder="搜房号" value="{{search}}" bindinput="onSearchInput" confirm-type="search"/>
    </view>

    <!-- 总价筛选 -->
    <range-filter 
      title="总价" unit="万"
      ranges="{{priceRanges}}"
      active="{{priceActive}}"
      bind:change="onPriceFilter"
    />
    <!-- 面积筛选 -->
    <range-filter 
      title="面积" unit="㎡"
      ranges="{{areaRanges}}"
      active="{{areaActive}}"
      bind:change="onAreaFilter"
    />

    <!-- 统计栏（跟随所有筛选） -->
    <view class="stat-bar" wx:if="{{stats}}">
      <view class="item"><text class="val t">{{stats.total}}</text><text class="lbl">总套数</text></view>
      <view class="sep"></view>
      <view class="item"><text class="val s">{{stats.sold}}</text><text class="lbl">已售</text><text class="pct">{{stats.sold_pct}}%</text></view>
      <view class="sep"></view>
      <view class="item"><text class="val u">{{stats.unsold}}</text><text class="lbl">可售</text><text class="pct">{{stats.unsold_pct}}%</text></view>
    </view>
  </view>

  <!-- 卡片列表 -->
  <view class="list">
    <block wx:if="{{loading}}">
      <view class="skeleton" wx:for="{{[1,2,3,4,5]}}" wx:key="*this">
        <view class="s-bar"><view class="s-line"></view><view class="s-line short"></view></view>
      </view>
    </block>

    <block wx:elif="{{units.length === 0}}">
      <view class="state-msg">{{search ? '暂无匹配房源，试试放宽条件' : '👆 选择小区开始查询'}}</view>
    </block>

    <block wx:else>
      <block wx:for="{{floors}}" wx:for-item="floor" wx:key="*this">
        <view class="floor-sep">
          <view class="line"></view>
          <text class="num">{{floor}}F</text>
          <view class="line"></view>
        </view>
        <price-card 
          wx:for="{{groups[floor]}}" 
          wx:for-item="unit" 
          wx:key="unit_no"
          unit="{{unit}}"
          project="{{projectName}}"
          bind:tap="onCardTap"
        />
      </block>
    </block>

    <view style="height: 32px;"></view>
  </view>
</view>

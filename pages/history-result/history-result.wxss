.page { background: #F7F7F7; min-height: 100vh; padding-bottom: 40rpx; }

/* 小区头部 */
.cm-header { background: #fff; padding: 20rpx 32rpx; display: flex; align-items: baseline; gap: 12rpx; }
.cm-name { font-size: 36rpx; font-weight: 700; color: #333; }
.cm-zone { font-size: 24rpx; color: #07C160; background: rgba(7,193,96,0.08); padding: 4rpx 14rpx; border-radius: 4rpx; }

/* 走势年份 */
.year-tabs-bar { background: #fff; padding: 0 32rpx 12rpx; }
.year-tabs { display: flex; gap: 8rpx; }
.year-tab { font-size: 22rpx; color: #888; padding: 4rpx 12rpx; border-radius: 6rpx; background: #f5f5f5; }
.year-tab.on { background: #07C160; color: #fff; font-weight: 600; }

/* 统计摘要 */
.stat-row { display: flex; gap: 1rpx; margin: 0 32rpx 12rpx; background: #E5E5E5; border-radius: 8rpx; overflow: hidden; }
.stat-item { flex: 1; background: #fff; text-align: center; padding: 14rpx 4rpx; }
.sv { font-size: 28rpx; font-weight: 700; color: #FF8C00; display: block; }
.sl { font-size: 20rpx; color: #888; margin-top: 2rpx; }

/* 走势图 */
.chart-card { background: #fff; margin: 0 32rpx 12rpx; border-radius: 8rpx; padding: 16rpx 20rpx; }
.chart-title { font-size: 26rpx; font-weight: 600; color: #333; margin-bottom: 8rpx; }
.year-tab.on { color: #fff; background: #07C160; }
.stat-item .su { font-size: 24rpx; font-weight: 400; }
.trend-canvas { width: 100%; height: 320rpx; }
.no-data { text-align: center; padding: 40rpx 0; color: #888; font-size: 24rpx; }

/* 筛选栏 */
.filter-bar { background: #fff; margin: 0 32rpx 12rpx; border-radius: 8rpx; padding: 12rpx 16rpx; }
.f-row { display: flex; gap: 8rpx; margin-bottom: 8rpx; align-items: center; }
.f-row:last-child { margin-bottom: 0; }
.picker-val { padding: 10rpx 16rpx; border-radius: 6rpx; border: 1rpx solid #E5E5E5; font-size: 24rpx; color: #888; background: #F7F7F7; white-space: nowrap; }
.picker-val.on { color: #07C160; border-color: #07C160; background: rgba(7,193,96,0.06); }
.f-input { flex: 1; padding: 10rpx 12rpx; border-radius: 6rpx; border: 1rpx solid #E5E5E5; font-size: 24rpx; background: #F7F7F7; text-align: center; min-width: 0; }
.f-dash { font-size: 24rpx; color: #888; flex-shrink: 0; }
.sort-tabs { display: flex; gap: 6rpx; flex: 1; overflow-x: auto; }
.sort-tab { padding: 8rpx 16rpx; border-radius: 6rpx; font-size: 22rpx; color: #888; background: #F7F7F7; white-space: nowrap; flex-shrink: 0; }
.sort-tab.on { background: #FF8C00; color: #fff; }
.filter-clear { font-size: 22rpx; color: #FF4D4F; padding: 8rpx 12rpx; flex-shrink: 0; }

/* 分区标题 */
.section-title-bar { padding: 8rpx 32rpx 4rpx; }
.section-title { font-size: 30rpx; font-weight: 700; color: #333; }

/* 排序栏 */
.sort-bar { display: flex; align-items: center; gap: 8rpx; padding: 4rpx 32rpx 8rpx; }

/* 结果信息 */
.result-info { display: flex; justify-content: space-between; align-items: center; padding: 4rpx 32rpx 8rpx; font-size: 24rpx; color: #888; }
.view-overview { color: #07C160; }

/* 成交列表 */
.tx-list { padding: 0 32rpx; }
.tx-card { background: #fff; border-radius: 8rpx; padding: 24rpx; margin-bottom: 10rpx; }
.tr-line { display: flex; justify-content: space-between; align-items: baseline; padding: 4rpx 0; }
.tr-left { font-size: 28rpx; color: #333; }
.tr-right { font-size: 28rpx; color: #333; text-align: right; }
.tr-price { font-size: 32rpx; font-weight: 700; color: #FF4D4F; }
.tr-punit { font-size: 22rpx; font-weight: 500; }
.tr-meta { font-size: 22rpx; color: #888; }

/* 分页 */
.pagination { display: flex; justify-content: center; align-items: center; gap: 8rpx; padding: 20rpx 32rpx 40rpx; }
.pg-btn { min-width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; border-radius: 8rpx; font-size: 28rpx; color: #333; background: #fff; border: 1rpx solid #E5E5E5; }
.pg-btn.on { background: #07C160; color: #fff; border-color: #07C160; }
.pg-btn.disabled { opacity: 0.3; }
.pg-ellipsis { padding: 0 4rpx; color: #888; }

/* 空态 */
.empty-block { text-align: center; padding: 80rpx 40rpx; color: #888; font-size: 28rpx; }
.empty-icon { font-size: 64rpx; display: block; margin-bottom: 16rpx; }
.empty-hint { display: block; font-size: 24rpx; margin-top: 8rpx; }
.clear-btn { display: inline-block; margin-top: 24rpx; padding: 12rpx 32rpx; border-radius: 20rpx; background: #07C160; color: #fff; font-size: 26rpx; }

/* 骨架屏 */
.loading-skel { padding: 32rpx; }
.skel-bar { height: 32rpx; background: #E5E5E5; border-radius: 6rpx; margin-bottom: 16rpx; width: 60%; }
.skel-chart { height: 200rpx; background: #E5E5E5; border-radius: 8rpx; margin-bottom: 16rpx; }
.skel-row { height: 80rpx; background: #E5E5E5; border-radius: 8rpx; margin-bottom: 12rpx; }

/* 错误 */
.err-block { background: #FFF7E6; border-radius: 8rpx; padding: 32rpx; text-align: center; color: #FAAD14; font-size: 28rpx; margin: 32rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.err-icon { width: 40rpx; height: 40rpx; line-height: 40rpx; border-radius: 50%; background: #FAAD14; color: #fff; font-size: 24rpx; font-weight: 700; text-align: center; }

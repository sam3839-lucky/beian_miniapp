.ub-wrap { margin: 24rpx 32rpx 0; }

.ub-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #FFF7E6;
  border-radius: 8rpx;
  border: 1rpx solid rgba(250, 173, 20, 0.2);
}
.ub-bar.low { background: #FFF2F0; border-color: rgba(255, 77, 79, 0.2); }

.ub-left { display: flex; align-items: baseline; gap: 16rpx; }
.ub-count { font-size: 24rpx; color: #333; }
.ub-num { font-weight: 700; color: #FAAD14; }
.ub-remain { font-size: 22rpx; color: #888; }
.ub-num-low { font-weight: 700; color: #FF4D4F; }
.ub-right {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #07C160;
  font-weight: 600;
  padding: 8rpx 16rpx;
  background: rgba(7, 193, 96, 0.08);
  border-radius: 6rpx;
}
.ub-right-hover { background: rgba(7, 193, 96, 0.15); }
.ub-arrow { font-size: 22rpx; }

.ub-progress { height: 4rpx; background: #F0F0F0; border-radius: 2rpx; margin-top: 8rpx; }
.ub-progress-inner { height: 100%; background: #FAAD14; border-radius: 2rpx; transition: width 0.3s; }

.card {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 8rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  border-left: 8rpx solid #07C160;
}
.r1 {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.r2 {
  display: flex;
  align-items: center;
  color: #888;
  font-size: 24rpx;
}
.bldg {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.date {
  flex: 1;
  text-align: center;
}
.up {
  flex: 1;
  text-align: right;
}
.no {
  font-size: 36rpx;
  font-weight: 800;
  color: #333;
}
.area {
  font-size: 28rpx;
  color: #888;
  text-align: center;
  flex: 1;
}
.price {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF4D4F;
}

.card {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 8rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  border-left: 8rpx solid #07C160;
}
.row {
  display: flex;
  align-items: stretch;
}
.col {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.col-left {
  flex: 1;
  min-width: 0;
}
.col-mid {
  flex: 1;
  align-items: center;
}
.col-right {
  flex: 1;
  align-items: flex-end;
}
.no {
  font-size: 36rpx;
  font-weight: 800;
  color: #333;
}
.area {
  font-size: 28rpx;
  color: #888;
}
.price {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF4D4F;
}
.sub {
  font-size: 24rpx;
  color: #888;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}
.sale-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  margin-top: 2rpx;
}
.tag-pre {
  color: #576B95;
  background: #EEF1F6;
}
.tag-spot {
  color: #FF8C00;
  background: #FFF5EB;
}

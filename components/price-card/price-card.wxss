.card {
  width: 100%;
  box-sizing: border-box;
  background: #fffefb;
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 8px;
  box-shadow: 0 1px 3px rgba(0,0,0,.05);
  border-left: 4px solid #07C160;
}
.r1 {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 6px;
}
.r2 {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  color: #a8a29e;
  font-size: 12px;
}
.no {
  font-size: 18px;
  font-weight: 800;
  color: #1c1917;
}
.area {
  font-size: 14px;
  color: #78716c;
  text-align: center;
  flex: 1;
}
.price {
  font-size: 18px;
  font-weight: 700;
  color: #dc2626;
}
.date {
  font-size: 12px;
  color: #a8a29e;
  text-align: center;
  flex: 1;
}

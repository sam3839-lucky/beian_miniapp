.filter-tags {
  display: flex;
  gap: 6px;
  align-items: center;
  overflow-x: auto;
  white-space: nowrap;
  padding: 2px 0;
}
.filter-tags::-webkit-scrollbar { display: none; }
.tag-label {
  font-size: 12px;
  color: #888;
  font-weight: 500;
  flex-shrink: 0;
  margin-right: 2px;
}
.tag {
  padding: 5px 12px;
  border-radius: 16px;
  font-size: 12px;
  border: 1px solid #E5E5E5;
  color: #888;
  background: #fff;
  flex-shrink: 0;
  transition: .15s;
}
.tag.on {
  background: #07C160;
  border-color: #07C160;
  color: #fff;
}

.filter-tags {
  display: flex;
  gap: 6px;
  align-items: center;
  overflow-x: auto;
  white-space: nowrap;
  padding: 2px 0;
}
.filter-tags::-webkit-scrollbar { display: none; }
.tag-label {
  font-size: 12px;
  color: #a8a29e;
  font-weight: 500;
  flex-shrink: 0;
  margin-right: 2px;
}
.tag {
  padding: 5px 12px;
  border-radius: 16px;
  font-size: 12px;
  border: 1px solid #e7e5e4;
  color: #78716c;
  background: #fff;
  flex-shrink: 0;
  transition: .15s;
}
.tag.on {
  background: #059669;
  border-color: #059669;
  color: #fff;
}

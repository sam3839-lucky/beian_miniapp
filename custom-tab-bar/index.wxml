<view class="tab-bar">
  <view 
    wx:for="{{list}}" 
    wx:key="index"
    class="tab-item {{selected === index ? 'active' : ''}}" 
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <image wx:if="{{item.normalIcon}}" class="tab-icon" src="{{selected === index ? item.activeIcon : item.normalIcon}}"></image>
    <text wx:else class="tab-emoji">{{item.icon}}</text>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>

.tab-bar {
  display: flex;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #E5E5E5;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.tab-icon {
  width: 48rpx;
  height: 48rpx;
}
.tab-emoji {
  font-size: 44rpx;
  line-height: 48rpx;
}
.tab-text {
  font-size: 20rpx;
  color: #888888;
  margin-top: 4rpx;
}
.tab-item.active .tab-text {
  color: #07C160;
}
